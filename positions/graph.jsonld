   "mappingConfidence": 0.3791,
   "mappingAmbiguous": true
  },
  {
   "@id": "https://wulfkaal.github.io/positions/2026-07-31-7841",
   "@type": "Claim",
   "identifier": "kaal:position:2026-07-31-7841",
   "text": "Blockchain in accounting, accountability and assurance: an overview presents the following source proposition: Then, the authors conducted an in vivo coding for the emerging themes found in the papers. This proposition is pertinent to Kaal's source-bound claim that Legacy systems at private investment funds and banks are more expensive, more error prone, and slower than emerging blockchain technologies, a gap illustrated by the $1.7 trillion in processing fees banks charged in 2014. The proposed response is an extension: the relationship should remain limited to the retrieved source proposition and the mapped Kaal claim unless fuller source review supports a broader conclusion.",
   "responseType": "extension",
