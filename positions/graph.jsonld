   "mappingConfidence": 0.3903,
   "mappingAmbiguous": true
  },
  {
   "@id": "https://wulfkaal.github.io/positions/2026-07-31-6747",
   "@type": "Claim",
   "identifier": "kaal:position:2026-07-31-6747",
   "text": "Contractualizing Corporate Governance presents the following source proposition: Yet, contract has also had the capacity to modify these duties in important—but uncertain—ways because neither body of law contains a meta-rule specifying which would “trump” in the event of conflict. This proposition is pertinent to Kaal's source-bound claim that Courts have recognized an enhanced fiduciary duty among participants in closely held corporations, holding that majority shareholders owe fiduciary duties not only to the corporation but to minority shareholders as a class. The proposed response is a qualification: the relationship should remain limited to the retrieved source proposition and the mapped Kaal claim unless fuller source review supports a broader conclusion.",
   "responseType": "qualification",
   "datePublished": "2026-07-31",
   "creativeWorkStatus": "Affirmed",
   "respondsTo": {
    "@id": "https://repository.law.miami.edu/umlr/vol80/iss3/6"
   },
   "extends": {
