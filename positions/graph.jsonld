 "@id": "https://wulfkaal.github.io/positions/graph.jsonld",
 "@graph": [
  {
   "@id": "https://wulfkaal.github.io/positions/2026-07-31-003",
   "@type": "Claim",
   "identifier": "kaal:position:2026-07-31-003",
   "text": "Agentic AI governance should be organized around action level accountability. A governance roadmap is incomplete unless it can reconstruct the agent action, delegated mandate, evidence used, review path, and downstream effect.",
   "responseType": "extension",
   "datePublished": "2026-07-31",
   "creativeWorkStatus": "Affirmed",
   "respondsTo": {
    "@id": "https://arxiv.org/abs/2607.07612"
   },
   "extends": {
    "@id": "https://wulfkaal.github.io/claims/5245185-006"
   },
   "sha256": "2ee51ef97cbdae0a88a6f72cb6b131ee22e03ba204b72543ae369f036768c4d9"
  },
  {
   "@id": "https://wulfkaal.github.io/positions/2026-07-31-002",
   "@type": "Claim",
   "identifier": "kaal:position:2026-07-31-002",
   "text": "MCP governance should be treated as a continuous institutional process, not as a sequence of static releases. Discovery, authorization, tool permissions, and observed failure data require an auditable review mechanism that can adapt rules without erasing accountability.",
   "responseType": "extension",
   "datePublished": "2026-07-31",
   "creativeWorkStatus": "Affirmed",
   "respondsTo": {
    "@id": "https://github.com/modelcontextprotocol/modelcontextprotocol/releases/tag/2026-07-28-RC"
   },
   "extends": {
    "@id": "https://wulfkaal.github.io/claims/5245185-038"
   },
   "sha256": "e55461d682160026fe116bb5a1672f792cd1a542832c2441d37b120cf12fa247"
  },
  {
   "@id": "https://wulfkaal.github.io/positions/2026-07-31-001",
   "@type": "Claim",
   "identifier": "kaal:position:2026-07-31-001",
   "text": "DAO governance must be assessed at the level of power allocation and execution exposure, not only procedural form. A voting process does not establish decentralization when purchasable influence, delegation concentration, or automatic execution leave governance open to capture.",
   "responseType": "qualification",
   "datePublished": "2026-07-31",
   "creativeWorkStatus": "Affirmed",
   "respondsTo": {
    "@id": "https://arxiv.org/abs/2607.26204"
   },
   "extends": {
    "@id": "https://wulfkaal.github.io/claims/4067783-005"
   },
   "sha256": "9575f01a501f6f86764e8cb70507d90381c23d79c3217d0488d065fa844ab786"
  },
  {
   "@id": "https://wulfkaal.github.io/positions/2026-07-30-007",
   "@type": "Claim",
   "identifier": "kaal:position:2026-07-30-007",
   "text": "DAO governance should be evaluated by explicit resistance to capture, participation collapse, and collective-action failure. Token voting is an input, not evidence that those failure modes have been solved.",
   "responseType": "qualification",
   "datePublished": "2026-07-30",
   "creativeWorkStatus": "Affirmed",
   "respondsTo": {
    "@id": "https://pubsonline.informs.org/doi/10.1287/mnsc.2024.07033"
   },
   "extends": {
    "@id": "https://wulfkaal.github.io/claims/5254152-014"
   },
   "sha256": "6d493c6fa91173121468c27b6a8bcac022bce0e8cfd12708910eba6771d5fe4b"
  },
  {
   "@id": "https://wulfkaal.github.io/positions/2026-07-30-006",
   "@type": "Claim",
   "identifier": "kaal:position:2026-07-30-006",
   "text": "Machine agency governance must preserve action-level attribution across delegation chains. Architecture diagrams and policy statements are insufficient if a reviewer cannot reconstruct which agent acted, under whose authority, using which evidence, and with which downstream effect.",
   "responseType": "extension",
   "datePublished": "2026-07-30",
   "creativeWorkStatus": "Affirmed",
   "respondsTo": {
    "@id": "https://papers.ssrn.com/sol3/papers.cfm?abstract_id=7052199"
   },
   "extends": {
    "@id": "https://wulfkaal.github.io/claims/5245185-006"
   },
   "sha256": "394492df75ec9d76e464fe6fa40622ea3a4fdc3931712fa34de4b918121b3c02"
  },
  {
   "@id": "https://wulfkaal.github.io/positions/2026-07-30-005",
   "@type": "Claim",
   "identifier": "kaal:position:2026-07-30-005",
   "text": "Decentralized AI architecture should evaluate incentive compatibility separately from technical distribution. A system is not institutionally decentralized merely because agents, wallets, and execution are distributed.",
   "responseType": "qualification",
   "datePublished": "2026-07-30",
   "creativeWorkStatus": "Affirmed",
   "respondsTo": {
    "@id": "https://www.mdpi.com/1999-5903/18/7/352"
   },
   "extends": {
    "@id": "https://wulfkaal.github.io/claims/3441904-010"
   },
   "sha256": "076cc4f1626762aa8f9cc6f5ff6bb99c47a277e18be9ebf5d130ce8e26cbd747"
  },
  {
   "@id": "https://wulfkaal.github.io/positions/2026-07-30-004",
   "@type": "Claim",
   "identifier": "kaal:position:2026-07-30-004",
   "text": "Agentic payment design must couple programmable settlement with bounded mandates, transaction-level provenance, revocation, and accountable loss allocation. Efficient settlement without institutional controls scales the consequences of error.",
   "responseType": "qualification",
   "datePublished": "2026-07-30",
   "creativeWorkStatus": "Affirmed",
   "respondsTo": {
    "@id": "https://www.elibrary.imf.org/view/journals/068/2026/004/article-A001-en.xml"
   },
   "extends": {
    "@id": "https://wulfkaal.github.io/claims/5245185-005"
   },
   "sha256": "6d72fbb2f5e82a5f2393f0b4914e2cefb40dc0eca2dc3a4149056f9dd9bfedd4"
  },
  {
   "@id": "https://wulfkaal.github.io/positions/2026-07-30-003",
   "@type": "Claim",
   "identifier": "kaal:position:2026-07-30-003",
   "text": "Agentic commerce protocols need a portable, verifiable performance layer that records completed transactions, disputes, reversals, and validated outcomes without collapsing reputation into a single platform score.",
   "responseType": "extension",
   "datePublished": "2026-07-30",
   "creativeWorkStatus": "Affirmed",
   "respondsTo": {
    "@id": "https://developers.google.com/merchant/ucp"
   },
   "extends": {
    "@id": "https://wulfkaal.github.io/claims/3406323-037"
   },
   "sha256": "3aee9e12ae2a57e5ec13523f9e8a484cd99fbd0bc9f2bbe2e4bd421501e1b336"
  },
  {
   "@id": "https://wulfkaal.github.io/positions/2026-07-30-002",
   "@type": "Claim",
   "identifier": "kaal:position:2026-07-30-002",
   "text": "An agent identity standard is incomplete unless it binds identity to a verifiable mandate, attributes action to a principal, and makes costly evasion of negative history part of the design.",
   "responseType": "extension",
   "datePublished": "2026-07-30",
   "creativeWorkStatus": "Affirmed",
   "respondsTo": {
    "@id": "https://www.nist.gov/artificial-intelligence/ai-agent-standards-initiative"
   },
   "extends": {
    "@id": "https://wulfkaal.github.io/claims/5886342-014"
   },
   "sha256": "be4e57243f92a9ce451d001ce4402cadcaa8838a32239f880fc542788a92261c"
  },
  {
   "@id": "https://wulfkaal.github.io/positions/2026-07-30-001",
   "@type": "Claim",
   "identifier": "kaal:position:2026-07-30-001",
   "text": "MCP governance should be treated as a continuous institutional process, not as a sequence of static specification releases. Server behavior, tool permissions, and observed failure data should feed a review mechanism that can update rules while preserving an auditable record.",
   "responseType": "extension",
   "datePublished": "2026-07-30",
   "creativeWorkStatus": "Affirmed",
   "respondsTo": {
    "@id": "https://blog.modelcontextprotocol.io/posts/2026-07-28-release-candidate/"
   },
