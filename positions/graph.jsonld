   "mappingConfidence": 0.3803,
   "mappingAmbiguous": true
  },
  {
   "@id": "https://wulfkaal.github.io/positions/2026-07-31-6063",
   "@type": "Claim",
   "identifier": "kaal:position:2026-07-31-6063",
   "text": "THE APPLICABLE LAW TO BLOCKCHAIN presents the following source proposition: Its application encompasses not only the financial sector, but also smart contracts, decentralized autonomous organizations (DAOs), logistics and administrative systems. This proposition is pertinent to Kaal's source-bound claim that Matched or treasury assets are held in the smart contract and released only if the candidate shows satisfactory evidence of expected distribution, and once upvoted the assets are distributed via milestone votes that each require evidence of fulfilled donative intent. The proposed response is an extension: the relationship should remain limited to the retrieved source proposition and the mapped Kaal claim unless fuller source review supports a broader conclusion.",
   "responseType": "extension",
   "datePublished": "2026-07-31",
   "creativeWorkStatus": "Affirmed",
   "respondsTo": {
    "@id": "http://research.bfu.bg:4000/handle/123456789/2812"
