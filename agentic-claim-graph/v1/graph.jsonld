    },
    {
      "id": "kaal:claim:2486570-023:source-passage",
      "type": "SourcePassage",
      "text": "These reforms alone may not create sufficient incentives for boards and management to improve governance and avoid N/DPA execution.",
      "text_sha256": "f5d3e70f44428d71f19adfbdf22f7caa338b64d31c9a8b9e07a1f83dbdc84a1b",
      "source_sha256": "8c3981c9a55d8a3fe59a01660584eebc3feb3fb9109ca65344095bebe4ae49a4",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:2486570-024",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/2486570-024",
      "text": "The threat of bad press, reputational harm, legal costs, stock price declines, and the cost of implementing mandated governance changes can partly substitute for the weak direct incentives, pushing boards and management to optimize governance and keep the entity out of an agreement.",
      "claim_type": "mechanism",
      "topics": [
        "reputation",
        "risk-and-incentives",
        "governance-design",
        "corporate-governance"
      ],
      "scope_conditions": [],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
