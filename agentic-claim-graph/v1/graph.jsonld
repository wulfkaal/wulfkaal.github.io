      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 48
    },
    {
      "id": "kaal:claim:6192998-032:source-passage",
      "type": "SourcePassage",
      "text": "This improved security stems from multi-agent competition creating multiple attack surfaces that must all succeed simultaneously, combined with citation transparency enabling collusion detection.",
      "text_sha256": "e6026248feb0a26cd53ecc3a0d8698c17e0cc2360a7dacce758a9ce751e5d9d1",
      "source_sha256": "b04292561ee041e0c9eaa7eca28a410ed440e76a95743a539361a3f76c97f2b3",
      "locator_status": "exact_quote_without_page_locator"
