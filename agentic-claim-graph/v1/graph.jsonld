    },
    {
      "id": "kaal:claim:2629451-001",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/2629451-001",
      "text": "Stock prices respond significantly and predictably in a positive direction to the DOJ press release announcing execution of a non- or deferred prosecution agreement and to the start of the N/DPA term.",
      "claim_type": "empirical",
      "topics": [
        "economics",
        "research-methods",
        "governance-design",
        "corporate-governance",
        "compliance"
      ],
      "scope_conditions": [
        "publicly traded U.S. firms that executed N/DPAs between 1993 and 2015",
        "event windows measured around the DOJ press release date and the start date of the N/DPA term"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "evidenced",
      "relevance_score": 18
    },
    {
      "id": "kaal:claim:2629451-001:source-passage",
      "type": "SourcePassage",
      "text": "We document a significant and predictable positive stock price response to the DOJ press release and the start of the N/DPA term.",
      "text_sha256": "236c76703709a9037fdc646eae9f266838051ec3dc50e4cda2498ab8f1528bdb",
      "source_sha256": "507404d641abb922ab6d8e3a0b032e35ead2befd7b88746d09d178a8fa816957",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:2629451-003",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/2629451-003",
      "text": "Investor response to N/DPAs is not uniform: it varies with the firm's industry, the severity of the financial fine, and the extent of the governance improvements the N/DPA mandates.",
      "claim_type": "empirical",
      "topics": [
        "governance-design"
      ],
      "scope_conditions": [
        "ten industry sub-clusters in the sample",
        "partitions relative to median fines and median governance intensity"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "evidenced",
      "relevance_score": 18
    },
    {
      "id": "kaal:claim:2629451-003:source-passage",
      "type": "SourcePassage",
      "text": "We also find that investor's response differs depending on the industry and severity of financial fines and N/DPA mandated governance improvements.",
      "text_sha256": "5521f2d70300054542cf69bb6d9cdd3c3545a37ef25438bd2fafdffaffb5f3cc",
      "source_sha256": "507404d641abb922ab6d8e3a0b032e35ead2befd7b88746d09d178a8fa816957",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:2629451-006",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/2629451-006",
      "text": "Investors treat the expiration of an N/DPA term as a negative event for the firm.",
      "claim_type": "empirical",
      "topics": [
        "governance-design"
      ],
      "scope_conditions": [
        "end of N/DPA term date, ENDPAT",
        "reduced sample of 59 firms where the end date fell on a trading day"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "evidenced",
      "relevance_score": 18
    },
    {
      "id": "kaal:claim:2629451-006:source-passage",
      "type": "SourcePassage",
      "text": "Inversely, our results suggest that investors see the expiry of applicable N/DPA terms as a negative event.",
      "text_sha256": "57b1b9f2cac61317e21b2ec1380b0dd719af7ebb6e374a2f9f884da0650449d0",
      "source_sha256": "507404d641abb922ab6d8e3a0b032e35ead2befd7b88746d09d178a8fa816957",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:2629451-007",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/2629451-007",
      "text": "The combination of a positive market reaction at the start of the N/DPA term and a negative reaction at its end is evidence that the governance changes N/DPAs mandate actually matter to firm value.",
      "claim_type": "mechanism",
      "topics": [
        "governance-design",
        "corporate-governance",
        "research-methods"
      ],
      "scope_conditions": [
        "governance changes become mandatory at the start of the term and unenforceable at its end"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 16
    },
    {
      "id": "kaal:claim:2629451-007:source-passage",
      "type": "SourcePassage",
      "text": "We interpret the positive market reaction at the beginning of the N/DPA term and investors' negative reaction at the end of the N/DPA term as evidence that governance changes mandated by N/DPAs matter.",
      "text_sha256": "ccd270a2677677fd011bb67ad619401a436fc143766bb2025b556781b1551255",
      "source_sha256": "507404d641abb922ab6d8e3a0b032e35ead2befd7b88746d09d178a8fa816957",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:2629451-022",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/2629451-022",
      "text": "From the first day of the N/DPA term through day twenty five, the period in which mandated governance improvements are in force, the market prices the N/DPA as a positive event for the firm.",
      "claim_type": "empirical",
      "topics": [
        "governance-design",
