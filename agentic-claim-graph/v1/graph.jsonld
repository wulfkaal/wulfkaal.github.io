    {
      "id": "kaal:claim:5541658-029",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/5541658-029",
      "text": "The literature offers high short term accuracy figures for judicial AI but almost no evidence on how these tools affect decision quality, case backlogs, or public trust over extended periods, which is a fundamental research gap.",
      "claim_type": "failure",
      "topics": [
        "reputation",
        "economics"
      ],
      "scope_conditions": [
        "the existing empirical literature on AI in judicial systems"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 54
    },
    {
      "id": "kaal:claim:5541658-029:source-passage",
      "type": "SourcePassage",
      "text": "while AI tools have demonstrated high accuracy in predicting case outcomes (e.g., 96.9% in the CAIL dataset), there is little evidence on how these tools affect judicial decision-making quality, case backlogs, or public trust over extended periods.",
      "text_sha256": "f10a21363c3f5c84f685acda3a785b4cef0ef77879297f1eaea209f6989bce6a",
      "source_sha256": "e543a2d698fcd522d4d02e034cc9ee1344d0015d2c824b40b9e05ab7c0728c60",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:5541658-038",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/5541658-038",
      "text": "A Dutch court's AI system for traffic violation appeals improved consistency yet altered legal experts' decisions, which shows that consistency gains from judicial AI can come at the cost of influencing expert judgment and therefore require human oversight.",
      "claim_type": "empirical",
      "topics": [
        "ai-and-agents",
        "empirical-evidence"
      ],
      "scope_conditions": [
        "a Dutch court",
        "traffic violation appeals",
        "high volume standardized decisions"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "evidenced",
      "relevance_score": 42
    },
    {
      "id": "kaal:claim:5541658-038:source-passage",
      "type": "SourcePassage",
      "text": "For example, a study of an AI system for traffic violation appeals in a Dutch court found that while AI improved consistency, it altered legal experts' decisions, highlighting the need for human oversight.",
      "text_sha256": "026c517bd6db35675b9c11ebcbaa5dcb2dd1523757580a7a693e7bdc0e6701f8",
      "source_sha256": "e543a2d698fcd522d4d02e034cc9ee1344d0015d2c824b40b9e05ab7c0728c60",
      "locator_status": "exact_quote_without_page_locator"
    },
