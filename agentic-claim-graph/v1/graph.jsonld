    },
    {
      "id": "kaal:claim:5583610-004",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/5583610-004",
      "text": "LER produces shareholder loyalty by using smart contracts to distribute consumptive utilities such as merchant vouchers or platform credits, so retention is encouraged without imposing any lock-up on the shareholder's liquidity.",
