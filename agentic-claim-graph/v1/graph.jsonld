    {
      "id": "kaal:claim:6244278-025",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/6244278-025",
      "text": "Institutional alignment resists gaming because the mechanisms that produce alignment are identical to the mechanisms that produce economic success: an agent cannot game its way to high reputation without actually performing competently and honestly.",
      "claim_type": "mechanism",
      "topics": [
        "regulatory-failure",
        "research-methods",
        "reputation",
        "ai-and-agents",
        "institutional-design"
      ],
      "scope_conditions": [
        "requires that competence and honesty be the sole criteria by which reputation is earned"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 71
    },
    {
      "id": "kaal:claim:6244278-025:source-passage",
      "type": "SourcePassage",
      "text": "An agent cannot \"game\" its way to high reputation without actually performing competently and honestly, because competence and honesty are the criteria by which reputation is earned.",
