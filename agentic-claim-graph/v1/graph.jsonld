    },
    {
      "id": "kaal:claim:3373393-019:source-passage",
      "type": "SourcePassage",
      "text": "The immutability of the blockchain and its cryptographic security systems provide transactional guarantees and create trust between principals and agents in the integrity of their contractual relationship.",
      "text_sha256": "5054fd190c4289bbd2538fe3f49c7f5435f02d84108c98c341048957b3fca1b5",
      "source_sha256": "4d1424b9ba9aff8a61bc7a0dddd02cded93785e5843685dde76c07dcdb23961e",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
