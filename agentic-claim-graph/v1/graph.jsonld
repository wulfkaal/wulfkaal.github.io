      "confidence": "evidenced",
      "relevance_score": 8
    },
    {
      "id": "kaal:claim:2998097-015:source-passage",
      "type": "SourcePassage",
      "text": "More than a third of respondents (34.9%) opined that Title IV will affect the private fund industry in the next five years because of additional expenses, and nearly a third (32.6%) opined that it will create barriers to entry to private fund market entrants. 50% of",
      "text_sha256": "e8fce1727274a77c1e071ee50dc154d9cb83d6f3b4d412c594f7c0b8c968d9a7",
      "source_sha256": "0955054f49c7011d33c285579bb046e6b284e42755b10fd2546a728c202669d5",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
