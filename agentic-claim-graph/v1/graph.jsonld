      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 26
    },
    {
      "id": "kaal:claim:3936876-031:source-passage",
      "type": "SourcePassage",
      "text": "Specialized digital custody audit procedures for verifying the bank maintains access controls for a cryptographic key will differ from the procedures used for physical assets.",
      "text_sha256": "89fc7d7eac9fce85b3b43d9573f838a5048a401f7c5563406b381c0cc7ebf84e",
