      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 8
    },
    {
      "id": "kaal:claim:2389416-029:source-passage",
      "type": "SourcePassage",
      "text": "It is possible that the enactment of the Dodd-Frank Act introduces incentives that are powerful enough to cause some hedge fund advisers to opt out of Dodd-Frank Act registration and disclosure through a strategic change of AUM size.",
      "text_sha256": "761d0b1833ae225e444fa9d2081bc139535a7f9bd2986251490282a3ef78a9a9",
      "source_sha256": "0e1c4615b104821577498d9655de43b9c5c3e985bb0215f56c038b8232be65c3",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:2389416-031",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/2389416-031",
      "text": "Some large advisers reduce their AUM in the months from May to August 2012, which strongly increases the discontinuity around the registration threshold and separates the two groups more sharply, though the effect vanishes late in the sample period.",
      "claim_type": "mechanism",
      "topics": [
        "risk-and-incentives",
        "research-methods"
      ],
      "scope_conditions": [
        "strategic subsample of 87 advisers",
        "May to August 2012"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "evidenced",
      "relevance_score": 8
    },
    {
      "id": "kaal:claim:2389416-031:source-passage",
      "type": "SourcePassage",
      "text": "In particular, some large advisers reduce their AUM. This leads to a strong increase in the discontinuity around the AUM registration threshold, suggesting a stronger separation between the two groups. The effect vanishes during the last months of our sample period.",
      "text_sha256": "6cebeddb692ec30c084124a106adb52388a921ec5ba76b4785c31946e2856bfa",
      "source_sha256": "0e1c4615b104821577498d9655de43b9c5c3e985bb0215f56c038b8232be65c3",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
