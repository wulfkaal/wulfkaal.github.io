    {
      "id": "kaal:claim:1998455-010:source-passage",
      "type": "SourcePassage",
      "text": "The threat of dilution of stock holdings in combination with a threat of loss due to conversion could help reduce shareholder pressure on SIFI management to take higher risks.",
