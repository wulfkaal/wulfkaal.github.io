      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "evidenced",
      "relevance_score": 8
    },
    {
      "id": "kaal:claim:2389416-014:source-passage",
      "type": "SourcePassage",
      "text": "We notice that only few hedge funds sensibly decrease or increase their AUM under or above the threshold and then keep such position. Most funds in the sample have AUM very close to the threshold, with oscillations around it.",
