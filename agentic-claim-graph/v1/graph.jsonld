    },
    {
      "id": "kaal:claim:3373393-024:source-passage",
      "type": "SourcePassage",
      "text": "Cryptographic hashes used in blockchain technology further increase blockchain security and removes trust barriers in agency relationships that require monitoring of agents and create agency costs.",
      "text_sha256": "99fc4672394702f875253707e8a60e7aec5fcdaa9ff306eaca95239add59b097",
