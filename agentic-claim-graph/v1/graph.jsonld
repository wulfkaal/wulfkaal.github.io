    {
      "id": "kaal:claim:2957645-011",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/2957645-011",
      "text": "Feedback effects change the timing of regulatory information: instead of acquiring necessary information only after rules have already proven suboptimal, they increase the availability of relevant information ex ante and support anticipation of necessary revisions.",
      "claim_type": "mechanism",
      "topics": [
        "institutional-design",
        "dynamic-regulation"
      ],
      "scope_conditions": [
        "an informational exchange process between regulated entities and rulemakers is in place"
