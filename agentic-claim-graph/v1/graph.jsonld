    {
      "id": "kaal:claim:1806252-013",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/1806252-013",
      "text": "Because banks expect to be bailed out with taxpayer funds, they may have less incentive to monitor their hedge fund lending activities, even though hedge funds are not themselves counterparties in government bailouts.",
      "claim_type": "mechanism",
      "topics": [
        "risk-and-incentives",
