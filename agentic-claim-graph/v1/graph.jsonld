    {
      "id": "kaal:claim:4734750-003",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/4734750-003",
      "text": "Losses from smart contract vulnerabilities are large and growing, with 2021 losses alone estimated at 680 million dollars and cumulative global losses estimated at over 6 billion dollars.",
