      "source_sha256": "0955054f49c7011d33c285579bb046e6b284e42755b10fd2546a728c202669d5",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:2998097-005",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/2998097-005",
      "text": "Post LTCM proposals for clearer credit risk strategies and credit risk management policies at financial intermediaries were inappropriately applied across the whole range of business models and lacked concrete implementation elements.",
      "claim_type": "failure",
      "topics": [
        "risk-and-incentives"
      ],
      "scope_conditions": [
