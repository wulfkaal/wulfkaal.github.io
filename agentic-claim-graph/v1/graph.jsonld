      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:2629451-036",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/2629451-036",
      "text": "Despite wide-ranging criticism of N/DPAs on authority, fairness, and expertise grounds, scholars agree that N/DPAs do influence corporate governance.",
      "claim_type": "empirical",
      "topics": [
        "consensus-and-security",
        "citation-and-knowledge",
        "governance-design",
        "corporate-governance"
      ],
      "scope_conditions": [
        "scholarly literature on N/DPAs through 2015"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "asserted",
      "relevance_score": 35
    },
    {
      "id": "kaal:claim:2629451-036:source-passage",
      "type": "SourcePassage",
      "text": "Despite the broad critique of N/DPAs, consensus exists among scholars that N/DPAs influence corporate governance (Cunningham 2014b, Kaal and Lacine 2014, Coffee 2005, Thompson 2003).",
      "text_sha256": "bc81b1ed6b38b7e7d206390e6119d0fb0ed38f92b40390cfd76b102aceebd294",
      "source_sha256": "507404d641abb922ab6d8e3a0b032e35ead2befd7b88746d09d178a8fa816957",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:2629451-039",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/2629451-039",
      "text": "Prior coding of all publicly available N/DPAs from 1993 to 2013 across more than 230 governance categories shows that N/DPAs have a substantial effect on corporate governance.",
      "claim_type": "empirical",
      "topics": [
        "governance-design",
        "corporate-governance"
      ],
      "scope_conditions": [
        "N=271 agreements, 1993 to 2013"
      ],
      "attribution_class": "source_derived",
