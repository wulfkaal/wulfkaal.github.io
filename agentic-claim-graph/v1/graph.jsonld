      "topics": [
        "economics",
        "reputation",
        "citation-and-knowledge",
        "institutional-design"
      ],
      "scope_conditions": [
        "applies where outputs are drawn from a generative distribution whose quality price does not convey"
      ],
      "attribution_class": "source_derived",
