    {
      "id": "kaal:claim:4021599-001",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/4021599-001",
      "text": "The absence of clearly defined technology features for blockchain, distributed ledger, and associated terms propagates outward, producing knock-on definitional problems in other parts of the blockchain ecosystem.",
      "claim_type": "mechanism",
      "topics": [
        "blockchain",
        "tokenomics"
      ],
      "scope_conditions": [
        "blockchain and distributed ledger terminology remains undefined"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 12
    },
    {
      "id": "kaal:claim:4021599-001:source-passage",
      "type": "SourcePassage",
      "text": "The lack of clearly defined technology features pertaining to blockchain technology, distributed ledger, and other associated terms has knock-on effects on other parts of the blockchain ecosystem.",
      "text_sha256": "33abda1b157d04c45a2c1e0cf9d2e5996f8cd4c1d2e4f4da51c95f65d42127cd",
      "source_sha256": "bb03790af46b3710e306121cfae25f850e3e7477e0f95313af42b9feeb6bc0c4",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:4021599-002",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/4021599-002",
      "text": "No truly uniform definition of blockchain technology exists; commentators variously describe it as a giant distributed immutable spreadsheet for transactions or by enumerating central elements such as decentralization, immutability, and cryptographic verification.",
      "claim_type": "definitional",
      "topics": [
        "blockchain",
        "decentralization",
        "consensus-and-security",
        "citation-and-knowledge"
      ],
      "scope_conditions": [],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 34
    },
    {
      "id": "kaal:claim:4021599-002:source-passage",
      "type": "SourcePassage",
      "text": "No truly uniform definition exists for blockchain technology. Some refer to it as a giant worldwide, distributed, immutable \"google spreadsheet\" for transactions.1",
      "text_sha256": "ccc981588dcc2b4c4ea4ef14a19eb1226bbf9eb46db7a98ef95af81a13797219",
      "source_sha256": "bb03790af46b3710e306121cfae25f850e3e7477e0f95313af42b9feeb6bc0c4",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:4021599-003",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/4021599-003",
      "text": "The core distinguishing features of blockchain technology are only generically definitional: they characterize the technology as a class but supply no specific definitions usable for classification.",
      "claim_type": "failure",
      "topics": [
        "blockchain",
        "systemic-risk"
      ],
      "scope_conditions": [],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 12
    },
    {
      "id": "kaal:claim:4021599-003:source-passage",
      "type": "SourcePassage",
      "text": "The core distinguishing features of blockchain technology help define the technology generically but provide no specific definitions. For example, the technology's distributed consensus",
      "text_sha256": "1123c670f7e1060ea58104f591608759860fc53698a3333dbfc7503eeda21d68",
      "source_sha256": "bb03790af46b3710e306121cfae25f850e3e7477e0f95313af42b9feeb6bc0c4",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:4021599-004",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/4021599-004",
      "text": "Blockchain's distributed consensus model makes fraudulent transactions much less likely to be recorded because individual network nodes verify and validate chain transactions before those transactions execute.",
      "claim_type": "mechanism",
      "topics": [
        "consensus-and-security",
        "blockchain"
      ],
      "scope_conditions": [
        "distributed consensus networks with node level validation"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 18
    },
    {
      "id": "kaal:claim:4021599-004:source-passage",
      "type": "SourcePassage",
      "text": "recorded as individual network nodes verify and validate chain transactions before the execution of the transactions.3 The resulting",
      "text_sha256": "8afaf97ecca896fc345304d1e7bcfb4eb104c6a8cd5b2c2170de15a51ca6e6fd",
      "source_sha256": "bb03790af46b3710e306121cfae25f850e3e7477e0f95313af42b9feeb6bc0c4",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:4021599-006",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/4021599-006",
      "text": "The lack of a clearly delineated nomenclature for the term securities token has produced divergent uses and interpretations of that term, especially in relation to the term utility token.",
      "claim_type": "failure",
      "topics": [
        "securities-law",
        "tokenomics",
        "systemic-risk"
      ],
      "scope_conditions": [
        "United States digital asset markets as of 2022"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 12
    },
    {
      "id": "kaal:claim:4021599-006:source-passage",
      "type": "SourcePassage",
      "text": "The lack of a clearly delineated nomenclature for the term \"securities token\" resulted in various uses and interpretations of the term securities token, especially vis-\u00e0-vis the term \"utility token.\"",
      "text_sha256": "22c43c705da2c53ba1c93a07a9cc3ab03f49192c2d13f85c4f138431690a6520",
      "source_sha256": "bb03790af46b3710e306121cfae25f850e3e7477e0f95313af42b9feeb6bc0c4",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:4021599-012",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/4021599-012",
      "text": "The literature on securities tokens converges on two commonalities: that a securities token functions as or is synonymous with traditional security assets, and that securities tokens are subject to traditional securities regulation.",
      "claim_type": "definitional",
      "topics": [
        "securities-law",
        "tokenomics",
        "consensus-and-security",
        "systemic-risk"
      ],
      "scope_conditions": [],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "evidenced",
      "relevance_score": 25
    },
    {
      "id": "kaal:claim:4021599-012:source-passage",
      "type": "SourcePassage",
      "text": "that a securities token functions as or is synonymous with traditional security assets,15 and 2. that securities tokens are subject to traditional securities regulation.16",
      "text_sha256": "0b5b9e0a673d9b09d9ac5306f46d7da6d99a7013c53b9c03ac095e747d952af6",
      "source_sha256": "bb03790af46b3710e306121cfae25f850e3e7477e0f95313af42b9feeb6bc0c4",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:4021599-016",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/4021599-016",
      "text": "Utility tokens are tokens with an intrinsic utility for a good or service: they emphasize the uses of the token and typically give users access to a product or service or give rewards that incentivize desirable behavior on the platform.",
      "claim_type": "definitional",
      "topics": [
        "tokenomics",
        "risk-and-incentives"
      ],
      "scope_conditions": [],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 14
    },
    {
      "id": "kaal:claim:4021599-016:source-passage",
      "type": "SourcePassage",
      "text": "The term utility token is used to identify tokens that have an intrinsic utility for a good or service. Utility tokens emphasize the uses of the token and typically give their users access to a product or service or give rewards to incentivize desirable behavior on the respective platform.25",
      "text_sha256": "25138effedece92982e0d1b14d04e6a880a87922a69b4962d5262a58233985b7",
      "source_sha256": "bb03790af46b3710e306121cfae25f850e3e7477e0f95313af42b9feeb6bc0c4",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:4021599-017",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/4021599-017",
      "text": "Utility tokens operate as an access mechanism: in order to interact with a given platform or use case, users are incentivized to acquire access rights to the product or service by acquiring the utility token.",
      "claim_type": "mechanism",
      "topics": [
        "tokenomics",
        "risk-and-incentives"
      ],
      "scope_conditions": [],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 14
    },
    {
      "id": "kaal:claim:4021599-017:source-passage",
      "type": "SourcePassage",
      "text": "In order to interact with a given platform or use case, users are incentivized to acquire access rights to the product or service through the acquisition of the utility token.",
      "text_sha256": "0e84195b748cec9af3694583bc2be5f91bcfa47c5170ec072938b7b4ec1da952",
      "source_sha256": "bb03790af46b3710e306121cfae25f850e3e7477e0f95313af42b9feeb6bc0c4",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:4021599-021",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/4021599-021",
      "text": "Merely calling a token a utility token, or structuring it so that it provides some utility, does not prevent the token from being characterized as a security.",
      "claim_type": "failure",
      "topics": [
        "tokenomics",
        "securities-law"
      ],
      "scope_conditions": [
        "United States regulatory characterization"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 12
    },
    {
      "id": "kaal:claim:4021599-021:source-passage",
      "type": "SourcePassage",
      "text": "From a regulatory perspective, merely calling a token a utility token or structuring it to provide some utility does not prevent the token from being characterized as a security.34 According to SEC",
      "text_sha256": "8e5e34a2906a185d7214c4373e6b96354a84ddf609ac739f251c6a5182758235",
      "source_sha256": "bb03790af46b3710e306121cfae25f850e3e7477e0f95313af42b9feeb6bc0c4",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:4021599-022",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/4021599-022",
      "text": "Under SEC guidance a token sold for use or consumption by purchasers may fall outside classification as a security, and the SEC lists characteristics whose stronger presence makes a token less likely to be considered a security.",
      "claim_type": "condition",
      "topics": [
        "securities-law",
        "systemic-risk",
        "tokenomics"
      ],
      "scope_conditions": [
        "SEC framework for investment contract analysis of digital assets"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "evidenced",
      "relevance_score": 12
    },
    {
      "id": "kaal:claim:4021599-022:source-passage",
      "type": "SourcePassage",
      "text": "According to SEC guidance, if a token is sold for use or consumption by purchasers it may not be classified as a security for regulatory purposes. The SEC provided a list of characteristics where, the stronger their presence,35 the less likely a token is to be considered a security.",
      "text_sha256": "21074f7c5292523671e12155779a8ce1c17dee83945459218507880ada3e244a",
      "source_sha256": "bb03790af46b3710e306121cfae25f850e3e7477e0f95313af42b9feeb6bc0c4",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:4033886-005",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/4033886-005",
      "text": "Dual listing narrows bid ask spreads in traditional markets by injecting liquidity, but crypto markets behave differently: price differences between two exchanges can reach upwards of five percent during peak trading times.",
      "claim_type": "empirical",
      "topics": [
        "economics",
        "defi"
      ],
      "scope_conditions": [
        "peak trading times",
        "assets listed on multiple crypto exchanges"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "evidenced",
      "relevance_score": 9
    },
    {
      "id": "kaal:claim:4033886-005:source-passage",
      "type": "SourcePassage",
      "text": "For traditional markets, when a security is dual- listed, we see the bid-ask spread decrease because additional liquidity is being injected into the market. This differs from the crypto market where the difference between the two exchanges can reach upwards of 5% during peak trading times.5",
      "text_sha256": "539a4547704177e6ef6478aa862e0b6823f09f4e8812be5a3c202a027a264e5c",
      "source_sha256": "52ba05b1292b1be4bfaf1ee5cf56b14fea9c196d870603e794d7ee316df129bd",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:4033886-008",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/4033886-008",
      "text": "Even for the most liquid level one digital assets, managers may choose between the price on a favored exchange and an aggregate across exchanges, so the same asset can be reported at different values by different managers.",
      "claim_type": "mechanism",
      "topics": [
        "economics",
        "defi"
      ],
      "scope_conditions": [
        "quoting level 1 digital assets"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "evidenced",
      "relevance_score": 9
    },
    {
      "id": "kaal:claim:4033886-008:source-passage",
      "type": "SourcePassage",
      "text": "For instance, when quoting level 1 securities, while some managers may use the price on their favored cryptocurrency exchange, others might take an aggregate the price from multiple exchanges.7",
      "text_sha256": "08274b3160423fc9597845cc8df37f6f72693d8225c63e4b17e422c111c4ac15",
      "source_sha256": "52ba05b1292b1be4bfaf1ee5cf56b14fea9c196d870603e794d7ee316df129bd",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:4033886-014",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/4033886-014",
      "text": "Redemption contracts, the traditional price commitment device for privately issued money, lack credibility, whereas pre programmed smart contracts deliver an enforceable and secure quantity commitment instead.",
      "claim_type": "failure",
      "topics": [
        "smart-contracts",
        "reputation",
        "tokenomics"
      ],
      "scope_conditions": [
        "issuers of privately issued money"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 41
    },
    {
      "id": "kaal:claim:4033886-014:source-passage",
      "type": "SourcePassage",
      "text": "Such redemption contracts lack credibility.31 In contrast, the pre-programmed smart contract's enabled by cryptocurrencies facilitate an enforceable and secure quantity commitment.32",
      "text_sha256": "25d242ff7582891f8d2cf4129623a2a58c7b7cf05b59bdde66fdedac8fd76db0",
      "source_sha256": "52ba05b1292b1be4bfaf1ee5cf56b14fea9c196d870603e794d7ee316df129bd",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:4033886-015",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/4033886-015",
      "text": "A programmed and enforceable quantity commitment secures a reliably positive value for Bitcoin because the governing source code is fully transparent on the blockchain and continuously verifiable.",
      "claim_type": "mechanism",
      "topics": [
        "disclosure",
        "tokenomics"
      ],
      "scope_conditions": [
        "cryptocurrencies with observable open source code"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 10
    },
    {
      "id": "kaal:claim:4033886-015:source-passage",
      "type": "SourcePassage",
      "text": "For instance, a programmed enforceable quantity commitment ensures a reliable positive value of Bitcoin.33 Cryptocurrencies' observable source code are fully transparent on their respective blockchain and continuously verifiable.34",
      "text_sha256": "9d14a2b50a9cce01eb806b4d71b60011a7e32b183f01be50de2fdedea6a49b9e",
      "source_sha256": "52ba05b1292b1be4bfaf1ee5cf56b14fea9c196d870603e794d7ee316df129bd",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:4033886-020",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/4033886-020",
      "text": "DCF currency translation breaks down for digital assets: no set discount rate or currency exchange forward curve exists for them, because they are not traded in exchange markets where closing prices are readily available and representative of fair value.",
      "claim_type": "failure",
      "topics": [
        "institutional-design"
      ],
      "scope_conditions": [
        "DCF analysis where the projection currency is a digital asset rather than fiat"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 13
    },
    {
      "id": "kaal:claim:4033886-020:source-passage",
      "type": "SourcePassage",
      "text": "However, no such set discount rate or currency exchange forward curve is available for digital assets, as they are not traded in exchange markets where closing prices are readily available and representative of fair value.79",
      "text_sha256": "1f4187daa811efdae883a24548bf440c896d95636f4a99a5c8d1e9668e499829",
      "source_sha256": "52ba05b1292b1be4bfaf1ee5cf56b14fea9c196d870603e794d7ee316df129bd",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:4033886-021",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/4033886-021",
      "text": "Principal to principal markets are generally not considered observable because little information about their transactions is publicly available, which pushes assets priced there out of the observable input levels.",
      "claim_type": "mechanism",
      "topics": [
        "institutional-design"
      ],
      "scope_conditions": [
        "principal to principal markets",
        "fair value input hierarchy"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "evidenced",
      "relevance_score": 15
    },
    {
      "id": "kaal:claim:4033886-021:source-passage",
      "type": "SourcePassage",
      "text": "There is often little information about principal-to-principal transactions publicly available, and as such the markets are generally not considered observable.81",
      "text_sha256": "efde1b1ff8f360d2627cbf87bd1680aefe69d233d4268c981e288e0894b627ff",
      "source_sha256": "52ba05b1292b1be4bfaf1ee5cf56b14fea9c196d870603e794d7ee316df129bd",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:4033886-024",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/4033886-024",
      "text": "The Longstaff model's assumptions are inconsistent with reality on two fronts: investors do not have perfect timing, and its assumed volatility of ten to thirty percent is far below the volatility exceeding fifty percent typical of small stocks.",
      "claim_type": "failure",
      "topics": [
        "institutional-design"
      ],
      "scope_conditions": [
        "application of the Longstaff model to small or highly volatile securities"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 13
    },
    {
      "id": "kaal:claim:4033886-024:source-passage",
      "type": "SourcePassage",
      "text": "The Longstaff model's underlying assumptions are inconsistent with the reality of perfect timing as well as the assumed volatility level between ten to thirty percent, yet small stocks typically have volatility exceeding fifty percent.113",
      "text_sha256": "72fb164188da96ef63a26ad4ed95dd5abb5bd9a7afd0512a1ad6ea958c3bbc69",
      "source_sha256": "52ba05b1292b1be4bfaf1ee5cf56b14fea9c196d870603e794d7ee316df129bd",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:4033886-026",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/4033886-026",
      "text": "The main obstacle to digital asset market liquidity may be that the number of token holders has not continued to expand exponentially year over year; a larger stakeholder base would deepen liquidity and permit seamless entry and exit.",
      "claim_type": "mechanism",
      "topics": [
        "defi",
        "tokenomics",
        "economics"
      ],
      "scope_conditions": [
        "centralized digital asset exchange markets"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 12
    },
    {
      "id": "kaal:claim:4033886-026:source-passage",
      "type": "SourcePassage",
      "text": "The main issue may be that the number of token holders have not continued to expand exponentially year over year. Having a greater number of stake holders may result in the deeper liquidity in the market, which would in turn allow for seamless movement in and out of the market.",
      "text_sha256": "79afaae2d8643c67ec4f4f58e4e3917745d07703cf26e56caa0d41a7513cde67",
      "source_sha256": "52ba05b1292b1be4bfaf1ee5cf56b14fea9c196d870603e794d7ee316df129bd",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:4033886-035",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/4033886-035",
      "text": "Secondary trade pricing from exchanges is a legitimate market approach input for digital assets only when liquidity is high enough to rely on those prices; where liquidity is lacking or unreliable, a discount for lack of liquidity is required.",
      "claim_type": "condition",
      "topics": [
        "defi",
        "economics",
        "tokenomics"
      ],
      "scope_conditions": [
        "market approach applied to tokens",
        "liquidity and depth differ between token to token and token to fiat trades"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 10
    },
    {
      "id": "kaal:claim:4033886-035:source-passage",
      "type": "SourcePassage",
      "text": "Secondary trade pricing (as seen in exchanges) are relevant when liquidity is high enough to rely on these prices.131",
      "text_sha256": "a8bf3d01a255d183a83a30d607e3e011e37ebe15307e37e7d1d54e8d1fde6620",
      "source_sha256": "52ba05b1292b1be4bfaf1ee5cf56b14fea9c196d870603e794d7ee316df129bd",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:4033886-040",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/4033886-040",
      "text": "Uniform digital asset valuation standards can only evolve over time as the market evolves, because standard setting requires common core practices, and those practices are only slowly emerging.",
      "claim_type": "condition",
      "topics": [
        "economics",
        "institutional-design"
      ],
      "scope_conditions": [
        "standard setting for digital asset valuation"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 11
    },
    {
      "id": "kaal:claim:4033886-040:source-passage",
      "type": "SourcePassage",
      "text": "Such standards can evolve over time as the market evolves. Standard setting requires common core practices what are slowly evolving.",
      "text_sha256": "c8cf35260b606ddcf8aae083466be20e12f40cd34040bdf5736e34b57720dbb6",
      "source_sha256": "52ba05b1292b1be4bfaf1ee5cf56b14fea9c196d870603e794d7ee316df129bd",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:4067783-011",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/4067783-011",
      "text": "Insider rug pulls are not the only exploit path: a DAO can also be attacked from the outside whenever its governance grants voting power through fungible tokens.",
      "claim_type": "failure",
      "topics": [
        "consensus-and-security",
        "tokenomics",
        "governance-design"
      ],
      "scope_conditions": [
        "governance voting power is denominated in fungible tokens"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 46
    },
    {
      "id": "kaal:claim:4067783-011:source-passage",
      "type": "SourcePassage",
      "text": "But these inside rug pulls are not the only exploitative mechanism within DAOs. DAOs can also be exploited from the outside if the DAO's governance allows fungible voting power.",
      "text_sha256": "a1855f16215e46bbb5742e579fc3d8eac5f00b88c6b86480ac1ec7792b1477d0",
      "source_sha256": "48f1e307cdbbe28c7843f7744d0ba8cf01662f257a53f2066a7a6c7e03a5acec",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:4067783-013",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/4067783-013",
      "text": "Dispersed, passive token holders cannot defend a DAO: because power in Build Finance DAO was not decentralized, the silent majority of token holders lacked the voting power to block the takeover, after which the attacker minted and sold tokens by draining liquidity pools.",
      "claim_type": "mechanism",
      "topics": [
        "consensus-and-security",
        "governance-design",
        "defi"
      ],
      "scope_conditions": [
        "low participation among dispersed token holders"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "evidenced",
      "relevance_score": 49
    },
    {
      "id": "kaal:claim:4067783-013:source-passage",
      "type": "SourcePassage",
      "text": "Because of the lack of decentralized power in the Build Finance DAO, the silent majority of token holders did not have enough voting power to prevent the takeover. As a result, the attacker minted and sold various tokens by draining liquidity pools.",
      "text_sha256": "e6d71c851647f474436fc8abd5b02d17a523257db6e51ccabe05a936e1a4feb2",
      "source_sha256": "48f1e307cdbbe28c7843f7744d0ba8cf01662f257a53f2066a7a6c7e03a5acec",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:4067783-014",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/4067783-014",
      "text": "Defending a DAO against attackers and looters, and punishing self-dealing, requires sustainable decentralized governance built on non-fungible tokens rather than tradable voting power.",
      "claim_type": "design",
      "topics": [
        "tokenomics",
        "governance-design",
        "consensus-and-security"
      ],
      "scope_conditions": [],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 50
    },
    {
      "id": "kaal:claim:4067783-014:source-passage",
      "type": "SourcePassage",
      "text": "The takeover of the Build Finance DAO highlights the need for sustainable decentralized governance solutions with non-fungible tokens to defend the DAO from attackers/looters and punish self- dealing.",
      "text_sha256": "bf6f41a9cae2822b7b5dd6716e46a1bfd95cf87d67d45ddac7b2be06829147c1",
      "source_sha256": "48f1e307cdbbe28c7843f7744d0ba8cf01662f257a53f2066a7a6c7e03a5acec",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:4067783-017",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/4067783-017",
      "text": "Workable DAO governance should account for reputation with non-fungible tokens or weighted keys rather than fungible tokens, so that voting weight tracks reputation instead of purchasing power.",
      "claim_type": "design",
      "topics": [
        "reputation",
        "tokenomics",
        "governance-design"
      ],
      "scope_conditions": [],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "asserted",
      "relevance_score": 53
    },
    {
      "id": "kaal:claim:4067783-017:source-passage",
      "type": "SourcePassage",
      "text": "1. Non-fungible Tokens or weighted keys, among other electronic accounting methods as accounting for reputation score NOT fungible tokens",
      "text_sha256": "24846bf92e460a552ee30ec5c2398daf2017fcef4d629572023d8263d44f0e5f",
      "source_sha256": "48f1e307cdbbe28c7843f7744d0ba8cf01662f257a53f2066a7a6c7e03a5acec",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:4067783-018",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/4067783-018",
      "text": "DAO governance should use a two vote model that distinguishes a loosely coupled vote, where no reputation is at stake, from a tightly coupled vote, where the voter's reputation is at stake.",
      "claim_type": "design",
      "topics": [
        "reputation",
        "governance-design"
      ],
      "scope_conditions": [],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "asserted",
      "relevance_score": 48
    },
    {
      "id": "kaal:claim:4067783-018:source-passage",
      "type": "SourcePassage",
      "text": "2. Two vote model a) loosely coupled vote (no reputation at stake), b) tightly coupled vote (reputation at stake)",
      "text_sha256": "d7348776027de5364f5748a0da9c171816e7afea7f9cba7ebd4ac883c783a890",
      "source_sha256": "48f1e307cdbbe28c7843f7744d0ba8cf01662f257a53f2066a7a6c7e03a5acec",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:4067783-019",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/4067783-019",
      "text": "Reputation in a DAO should be generated only for long term valuable work and for the policing of work, and never for business development work.",
      "claim_type": "design",
      "topics": [
        "reputation",
        "risk-and-incentives",
        "governance-design"
      ],
      "scope_conditions": [],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "asserted",
      "relevance_score": 52
    },
    {
      "id": "kaal:claim:4067783-019:source-passage",
      "type": "SourcePassage",
      "text": "3. Reputation generated ONLY for long term valuable work and policing of work NOT for business development work",
      "text_sha256": "df9003cfd99d0dcdbb3303ea31e9078e556cf7566be68d5cae743ad79054aae8",
      "source_sha256": "48f1e307cdbbe28c7843f7744d0ba8cf01662f257a53f2066a7a6c7e03a5acec",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:4067783-025",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/4067783-025",
      "text": "The friction generated by anonymous trolling can be mitigated through incentivized reputational architecture governed by protocols the community itself decides on, so anonymity does not have to corrupt DAO governance.",
      "claim_type": "design",
      "topics": [
        "reputation",
        "governance-design"
      ],
      "scope_conditions": [
        "reputational architecture is implemented correctly and community governed"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 55
    },
    {
      "id": "kaal:claim:4067783-025:source-passage",
      "type": "SourcePassage",
      "text": "By contrast, if implemented correctly, anonymity significantly upgrades DAO governance. The friction that arises from anonymous trolling can be mitigated through the implementation of incentivized reputational architecture governed by protocols decided upon by the community.",
      "text_sha256": "2b7d6aa6c252e80bd07bec9369a6234f56059bb482e97cf402ee7f642771f38c",
      "source_sha256": "48f1e307cdbbe28c7843f7744d0ba8cf01662f257a53f2066a7a6c7e03a5acec",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:4067783-029",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/4067783-029",
      "text": "A meaningful reputation governance and accounting mechanism for motivating business and governance participation is what encourages mutually beneficial contributions to a DAO community.",
      "claim_type": "mechanism",
      "topics": [
        "reputation",
        "risk-and-incentives"
      ],
      "scope_conditions": [
        "a meaningful reputation governance and accounting mechanism is in place"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 46
    },
    {
      "id": "kaal:claim:4067783-029:source-passage",
      "type": "SourcePassage",
      "text": "A meaningful reputation governance and accounting mechanism for motivating business and governance participation encourages mutually beneficial contributions to the community.",
      "text_sha256": "0492a09b4f41140ca73abaf61c99706e1372ed15e3d589745964cd313340f701",
      "source_sha256": "48f1e307cdbbe28c7843f7744d0ba8cf01662f257a53f2066a7a6c7e03a5acec",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:4067783-033",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/4067783-033",
      "text": "Braintrust demonstrates that innovation in work structure does not cure governance design: despite redefining work outcomes, it uses a suboptimal one token, one vote model that grants proportional control over network governance.",
