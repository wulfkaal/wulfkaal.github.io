    {
      "id": "kaal:claim:2029983-019",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/2029983-019",
      "text": "The German KapMuG does not relieve trial judges of deciding the legal issues in every individual case, so it remains administratively burdensome even though its model case judgment binds the trial courts.",
      "claim_type": "failure",
      "topics": [
        "institutional-design"
      ],
      "scope_conditions": [
        "German model case proceedings for capital markets claims"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 10
    },
    {
      "id": "kaal:claim:2029983-019:source-passage",
      "type": "SourcePassage",
      "text": "The KapMuG, how- ever, does not discharge the trial judges from addressing the legal issues in each and every case individually.",
      "text_sha256": "d35fdaf8bf22655fb68900bf2d4126e72ee18a2662e50be6bb7e34a0ee7662b0",
      "source_sha256": "fde2ff611420eb283cbb49a6b681a2ae8efa2b4603ae71480e2d91483f0295f2",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:2029983-020",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/2029983-020",
      "text": "The WCAM's requirement that a court evaluate procedural and substantive fairness and the efficiency of the settlement lets the Dutch system avoid blackmail settlements, where a defendant pays simply to escape endless proceedings and reputational loss.",
      "claim_type": "mechanism",
      "topics": [
        "institutional-design"
      ],
      "scope_conditions": [
        "Dutch collective settlements certified by the Amsterdam Court of Appeal"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 26
    },
    {
      "id": "kaal:claim:2029983-020:source-passage",
      "type": "SourcePassage",
      "text": "The WCAM, thus, avoids black- mail settlements in which a defendant offers a payment to get out of a class action to avoid the prospect of endless proceedings",
