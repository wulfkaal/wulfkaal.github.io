    {
      "id": "kaal:claim:1664809-033",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/1664809-033",
      "text": "Overlapping regulation must be distinguished from conflicting regulation: only conflicting regulation could violate international law, because the territorial integrity of a state is breached only where there is a specific true conflict in the substantive legal norms of the respective states.",
