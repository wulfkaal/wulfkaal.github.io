    {
      "id": "kaal:claim:6421319-001",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/6421319-001",
      "text": "Economic institutions that rely on lagging indicators such as price signals, employment data, and GDP reports cannot detect AI driven transformation, because the transformation propagates faster than the monitoring systems built to observe it.",
      "claim_type": "failure",
      "topics": [
        "institutional-design",
        "research-methods",
        "economics",
        "ai-and-agents"
      ],
      "scope_conditions": [
        "applies to institutions whose detection depends on advance warning indicators"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 33
    },
    {
      "id": "kaal:claim:6421319-001:source-passage",
      "type": "SourcePassage",
      "text": "Institutions in linear systems that depend on advance warning\u2014price signals, employment data, and GDP reports\u2014cannot detect a transformation that propagates faster than the information systems designed to monitor it.",
      "text_sha256": "32cc5b3afff718818ce36accea5bded34a1be899f577aeadb564999970d96170",
      "source_sha256": "0f4f68e56ee48bb8b2d73d3ab7fd96fa572e76c195694ffa740360704c1b172d",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:6421319-005",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/6421319-005",
      "text": "Humans remain the terminal consumers of AI generated value but cease to be its proximate driver, and this distinction is why traditional demand side economics loses descriptive accuracy in the agentic layer.",
      "claim_type": "condition",
      "topics": [
        "economics",
        "ai-and-agents"
      ],
      "scope_conditions": [
        "applies to the agentic layer, not to immediate human consumption transactions"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 43
    },
    {
      "id": "kaal:claim:6421319-005:source-passage",
      "type": "SourcePassage",
      "text": "This distinction between terminal and proximate consumption is essential for understanding why traditional demand-side economics, which assumes that human consumption decisions directly drive production decisions at each margin, loses its descriptive accuracy in the agentic layer.",
      "text_sha256": "d179fc34bde23027992b3586b41e66d43256a84bc7944e4a9697ec2d94130709",
      "source_sha256": "0f4f68e56ee48bb8b2d73d3ab7fd96fa572e76c195694ffa740360704c1b172d",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:6421319-006",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/6421319-006",
      "text": "The institutional lag between technological capability and governance capacity is approaching a structural singularity in which governance instruments designed for the prior era cannot meaningfully constrain or direct the new forces.",
      "claim_type": "failure",
      "topics": [
        "institutional-design",
        "governance-design"
      ],
      "scope_conditions": [
