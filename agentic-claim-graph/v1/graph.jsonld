      "source_sha256": "fde2ff611420eb283cbb49a6b681a2ae8efa2b4603ae71480e2d91483f0295f2",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:2029983-022",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/2029983-022",
      "text": "In Converium the Amsterdam Court of Appeal declared an international collective settlement binding on the parties even though the class members had only tenuous connections to the Netherlands.",
      "claim_type": "empirical",
      "topics": [
        "law-and-legal-systems"
      ],
      "scope_conditions": [
        "WCAM collective settlement proceedings",
        "none of the defendants and only a few plaintiffs were domiciled in the Netherlands",
        "alleged wrongdoing occurred outside the Netherlands and claims were not brought under Dutch law"
