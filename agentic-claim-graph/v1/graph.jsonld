      "source_sha256": "507404d641abb922ab6d8e3a0b032e35ead2befd7b88746d09d178a8fa816957",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:2629451-029",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/2629451-029",
      "text": "The data support Hypothesis 3: the market reacts positively when N/DPA governance changes become mandatory at the start of the term and negatively when they cease to be mandatory at its end.",
      "claim_type": "empirical",
      "topics": [
