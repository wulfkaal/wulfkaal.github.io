      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:6655138-020",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/6655138-020",
      "text": "Cross-surface reflection proposals must be advisory rather than binding, because the target agent's objective component is private and a reallocation that would raise reputation accrual may still be misaligned with that objective; coercive reallocation would violate the autonomy of the objective, which the architecture preserves.",
      "claim_type": "design",
      "topics": [
        "ai-and-agents"
      ],
      "scope_conditions": [
        "the cross-surface reflection surface only"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 40
    },
    {
      "id": "kaal:claim:6655138-020:source-passage",
      "type": "SourcePassage",
      "text": "First, \u03a3_R proposals are advisory rather than binding: the target agent's compute allocation cannot be coerced by a confirmed reallocation proposal, since the agent's O component is private and the reallocation might be misaligned with the agent's objective",
      "text_sha256": "aa44adf908c7853eb871bff03417a9c82d6493339d796a92b5e67c0bcc398713",
      "source_sha256": "52cb210167f06f0c7a2581214b156326216543de80b8394320b629c045c9e214",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:6655138-022",
