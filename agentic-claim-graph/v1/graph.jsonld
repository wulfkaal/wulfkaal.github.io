    },
    {
      "id": "kaal:claim:3373393-007:source-passage",
      "type": "SourcePassage",
      "text": "Agency problems originate from the lacking trust between principals and agents.",
      "text_sha256": "9bc68437392e3a81d62c6d39c1779fb73b9ed08b6e3f29cbc5c3d1b84a51d755",
