    },
    {
      "id": "kaal:claim:2831040-025:source-passage",
      "type": "SourcePassage",
      "text": "Because in a dynamic regulatory framework, the regulatory challenges associated with innovation would become transparent in real- time, early regulatory intervention would not be necessary.",
      "text_sha256": "0dcaaf7bbc65d9843e0d9d7c4e44a8e8752dc43a83eff0c77d580677044f0891",
