    },
    {
      "id": "kaal:claim:3782220-039",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/3782220-039",
      "text": "Decentralized organizations demand more from their members and return more autonomous power and profit, whereas centralized organizations shelter members in a niche and limit and stultify their power in exchange for security.",
      "claim_type": "mechanism",
      "topics": [
        "decentralization",
        "risk-and-incentives",
        "ai-and-agents"
      ],
      "scope_conditions": [],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 33
    },
    {
      "id": "kaal:claim:3782220-039:source-passage",
      "type": "SourcePassage",
      "text": "Decentralized organizations demand more from their members and return more, in autonomous power and profit. Centralized organizations shelter their members within a niche in a hierarchy. Centralized organizations limit the power of their mem- bers, stultifying them,",
      "text_sha256": "458a1dbc565108ab503fa6863cbe9bdf1d0bc7ab80011f6e9f10155169ebe5e3",
