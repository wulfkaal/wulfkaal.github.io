    },
    {
      "id": "kaal:claim:3782205-021:source-passage",
      "type": "SourcePassage",
      "text": "This is the proper goal, instead of money, for motivating good behavior in business and governance. Properly accounting for reputation switches the incentives from short-term zero-sum thinking to long-term positive-sum behavior.",
      "text_sha256": "a68b124975405dad51c6942805123991b308fb4b795df2c4f300d9b04d74ba55",
      "source_sha256": "5ba52c63e81019b6867fb29c4a50821ff574e510d79b31b8ce9f4c726a0ebc71",
