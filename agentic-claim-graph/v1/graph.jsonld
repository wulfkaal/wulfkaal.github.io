      "confidence": "evidenced",
      "relevance_score": 54
    },
    {
      "id": "kaal:claim:7314479-028:source-passage",
      "type": "SourcePassage",
      "text": "The entry structure, defined in electron/integrations/sandbox/types.ts, is exactly five fields: id, timestamp, source, type, and data. There is no workflow identifier, no parent-entry reference, no agent or principal identity, and no session or correlation field on the entry.",
      "text_sha256": "e19b8a227f54d2ffaf92064538c29237b6110e84b8744652d545049fee086e8e",
      "source_sha256": "debace24a155ae924a155b1fafe98856d98cf83689feff2f87a32f1c06171ce6",
      "locator_status": "exact_quote_without_page_locator"
    },
