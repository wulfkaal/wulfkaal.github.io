      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 55
    },
    {
      "id": "kaal:claim:5225296-009:source-passage",
      "type": "SourcePassage",
      "text": "For example, whereas Bitcoin's upgrade process can take years due to miner-developer negotiations, SPoS's embedded governance could enact changes in weeks or days, mirroring the agility of Tendermint's consensus model",
      "text_sha256": "ca55642f225e2ec5def80a24273b0522ae5178ee4eec06e32d219fd3f048760d",
      "source_sha256": "b2fec675d906334ad67e13b2d97261dc31e38061022867eb3f9ceadd95f4878d",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:5225296-010",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/5225296-010",
      "text": "On-chain governance systems outperform traditional governance models in responsiveness only if they incorporate robust anti-collusion measures, a requirement SPoS meets through its cryptographic commitments.",
      "claim_type": "condition",
      "topics": [
        "dao",
        "governance-design",
        "consensus-and-security",
        "citation-and-knowledge"
      ],
      "scope_conditions": [
