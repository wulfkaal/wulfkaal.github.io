    },
    {
      "id": "kaal:claim:3709041-033",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/3709041-033",
      "text": "Consumers increasingly favor genetically unmodified organic food from local and sustainable sources, yet the integrity of such products is usually difficult to verify, a verification gap blockchain technology can close.",
      "claim_type": "failure",
      "topics": [
        "citation-and-knowledge",
        "reputation"
      ],
      "scope_conditions": [],
      "attribution_class": "source_derived",
