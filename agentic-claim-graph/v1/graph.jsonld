    },
    {
      "id": "kaal:claim:2998033-034",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/2998033-034",
      "text": "Blockchain enabled per transaction fees align fees with strategy turnover: clients in transaction intensive strategies agree upfront to higher fees while clients in less transaction rich strategies pay lower overall fees.",
      "claim_type": "design",
      "topics": [
        "ai-and-agents",
        "disclosure",
        "economics"
      ],
      "scope_conditions": [
        "assumes the per transaction fee is predetermined with clients and can be made publicly available"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 20
    },
    {
      "id": "kaal:claim:2998033-034:source-passage",
      "type": "SourcePassage",
      "text": "Accordingly, clients who invest in a more transaction-prone strategy will be able to agree upfront to higher fees whereas clients who invest in a less transaction-rich strategy will pay overall lower fees.",
      "text_sha256": "b53881a28efaf33be6ca52f1b521551aa11100195c7a3e7103a46e03308bbc3c",
      "source_sha256": "aafb1be3c25cd33da477d759df9ca2f856f0a8fe133d6396da2e75d0af573dbd",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:2998097-004",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/2998097-004",
      "text": "Banks overexposed themselves to private investment fund lending, which allowed LTCM and similar funds to grow significantly and led banks as counterparties to put their own existence at risk.",
