    },
    {
      "id": "kaal:claim:3406323-036:source-passage",
      "type": "SourcePassage",
      "text": "Decentralized reputation verification systems enable mathematically rigid smart contracts to become more adjustable for the needs of business. Reputation verification becomes the backstop for smart contracting.",
