      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 16
    },
    {
      "id": "kaal:claim:2831040-026:source-passage",
      "type": "SourcePassage",
      "text": "In the theoretical dynamic regulatory framework, feedback effects and real-time information on regulatory challenges associated with innovation allow regulatory intervention if and only when needed.",
