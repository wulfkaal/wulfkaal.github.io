    {
      "id": "kaal:claim:3409548-003",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/3409548-003",
      "text": "Current hedge fund trading technology is hard coded by humans, whereas deep learning systems can be given a simple command and derive a result from data on their own; this is the operative difference between legacy quantitative tools and machine learning.",
