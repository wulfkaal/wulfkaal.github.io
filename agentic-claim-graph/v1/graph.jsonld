    {
      "id": "kaal:claim:1558614-018:source-passage",
      "type": "SourcePassage",
      "text": "It may be difficult for a co-determined Aufsichtsrat to respond quickly to rapidly changing developments, such as an escala- tion of financial risk in a securities portfolio or a liquidity crisis.",
      "text_sha256": "73733c8a0f9b499916d9a3aa28beae124034b7da00b81ab53a982e876304a080",
      "source_sha256": "e898211630f4116879329d6de8397523dca5b066864147421aa5cbc7429dc83b",
