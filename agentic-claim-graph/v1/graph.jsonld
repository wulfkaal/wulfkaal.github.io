      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:2389416-015",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/2389416-015",
      "text": "The largest number of strategic funds moving their AUM below $150 million occurs in the April to May 2012 window, which suggests a lagged response to the March 30, 2012 registration effective date.",
      "claim_type": "empirical",
      "topics": [
        "securities-law",
        "risk-and-incentives"
      ],
      "scope_conditions": [
        "strategic subsample",
        "period April to May 2012"
      ],
