      "source_sha256": "c7626eeb7642045b79f8745df1f7232a8fe8bc44a1f7e87b592850e35b392b50",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:3411110-028",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/3411110-028",
      "text": "The SEC's rejection of the Winklevoss Bitcoin ETF, reasoned on Bitcoin's unregulated nature and susceptibility to fraud, reflects agency distrust of the crypto asset class as a whole rather than a narrow product objection.",
      "claim_type": "empirical",
      "topics": [
        "tokenomics",
        "securities-law",
        "risk-and-incentives"
      ],
      "scope_conditions": [
        "SEC order disapproving the Winklevoss Bitcoin Trust listing"
