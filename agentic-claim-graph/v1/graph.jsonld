      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:3373393-018",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/3373393-018",
      "text": "Blockchain provides an alternative governance mechanism that eliminates agency costs, meaning the principal's cost of supervising agents, by creating trust in the contractual relationship between principal and agent.",
      "claim_type": "mechanism",
      "topics": [
        "blockchain",
        "corporate-governance",
        "reputation",
        "governance-design"
      ],
      "scope_conditions": [],
