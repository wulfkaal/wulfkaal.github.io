    {
      "id": "kaal:claim:3782205-026",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/3782205-026",
      "text": "Reputation and governance are the two most important institutions missing from the decentralized economy, and once they are solved the remaining missing pieces are relatively easy to supply.",
      "claim_type": "design",
      "topics": [
        "reputation",
        "governance-design",
        "decentralization",
        "economics"
      ],
      "scope_conditions": [],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
