    },
    {
      "id": "kaal:claim:2998033-030:source-passage",
      "type": "SourcePassage",
      "text": "Anecdotal evidence suggests that the majority of private fund advisers that use blockchain technology, artificial intelligence, and big data in different aspects of their operations or strategy have a substantially lower fee structure than those who do not use them.",
      "text_sha256": "27e9ed9b52ec154bd9cb20ec0253fd416ac20571837b0f74c5ba1ad5f6f9e1f0",
