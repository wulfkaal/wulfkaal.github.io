    {
      "id": "kaal:claim:1998455-016",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/1998455-016",
      "text": "If a market evolves in which contingent capital designs appear to provide sufficient protection against systemic risk and contagion, decision makers may come to rely on the design of those securities and neglect their own role as monitors.",
      "claim_type": "failure",
      "topics": [
