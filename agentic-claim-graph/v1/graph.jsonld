      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "evidenced",
      "relevance_score": 18
    },
    {
      "id": "kaal:claim:617681-043:source-passage",
      "type": "SourcePassage",
      "text": "In the ten months after the Inspire Art decision, at least 48 such companies with German names and the designation GmbH in their names were formed as private limited companies under U.K. law.",
      "text_sha256": "0b335014d834532c90b8746c4645b6da836f132b21091be5068c71cbeefc2c59",
      "source_sha256": "e142130507ea2f5b025fd97b3f762d44ee3a7aaa82b155aab63434b85e8fd834",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:6192998-001",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/6192998-001",
      "text": "Reputation systems that depend on persistent identity collapse in decentralized settings because agents can create new identities at no cost, so a poorly performing agent abandons its account and starts fresh, a practice known as whitewashing.",
