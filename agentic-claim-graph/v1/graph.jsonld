      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:3799320-024",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/3799320-024",
      "text": "The DAO of DAOs uses a duality of internal and external governance: internal governance runs on reputation token staking, while external legal relationships are handled by a legal wrapper that represents the DAO of DAOs in real world legal contexts.",
      "claim_type": "design",
      "topics": [
        "dao",
        "law-and-legal-systems",
        "reputation",
        "governance-design"
      ],
      "scope_conditions": [
        "DAO of DAOs architecture"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 64
    },
    {
      "id": "kaal:claim:3799320-024:source-passage",
      "type": "SourcePassage",
      "text": "For the external legal relationships and governance, the DAO of DAOs is represented in real-world legal contexts by a legal wrapper.",
      "text_sha256": "aa1c3538517549cb7ae2e4ecaec605cc47cba3bd6c8c172589646e31b5122b12",
      "source_sha256": "c3dff852f2d3f04718c829a24189309a7db4d92d84f6045d3d4f562d87c03e63",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:3799320-028",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/3799320-028",
      "text": "Reputation based staking removes the corruptive elements of fungible tokens because third parties are less likely able to take over a non fungible asset such as reputation that is organically grown and maintained through actual expertise in the relevant subject matter.",
      "claim_type": "mechanism",
      "topics": [
        "reputation",
        "governance-design",
        "consensus-and-security"
      ],
      "scope_conditions": [
        "reputation staked as a non fungible asset",
        "reputation earned through subject matter expertise"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 77
    },
    {
      "id": "kaal:claim:3799320-028:source-passage",
      "type": "SourcePassage",
      "text": "The corruptive elements of fungible assets/tokens are removed because third parties are less likely able to take over a non-fungible asset, such as reputation, that is organically grown and maintained through actual expertise in a given DAO subject matter.",
      "text_sha256": "5fee0f595be97933661b7d4f24cf3307719882be28238182e851a6d48ee8e36a",
      "source_sha256": "c3dff852f2d3f04718c829a24189309a7db4d92d84f6045d3d4f562d87c03e63",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:3799320-029",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/3799320-029",
      "text": "Reputation voting has two advantages over one token one vote: it is non fungible, which avoids corruptive elements, and it aligns incentives for members individually and for the institution as a whole at the same time.",
      "claim_type": "design",
      "topics": [
        "reputation",
        "governance-design",
        "ai-and-agents",
        "risk-and-incentives",
        "dao"
      ],
      "scope_conditions": [
        "DAO of DAOs internal governance"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 78
    },
    {
      "id": "kaal:claim:3799320-029:source-passage",
      "type": "SourcePassage",
      "text": "1) it is non-fungible which avoids corruptive elements, and 2) it optimally aligns incentives for DAO of DAOs members individually and at the same time aligns their incentives for the totality of the DAO of DAOs as an institution.",
      "text_sha256": "96b580f8c70458d46ba873df0c25af3120428e0d40959a7785ddf582d70e210b",
      "source_sha256": "c3dff852f2d3f04718c829a24189309a7db4d92d84f6045d3d4f562d87c03e63",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:3799320-030",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/3799320-030",
      "text": "In the bifurcated DAO of DAOs token design, non fungible reputation tokens give members voting rights while fungible reputation salary tokens let members earn a salary in proportion to their non fungible reputation holdings.",
      "claim_type": "design",
      "topics": [
        "tokenomics",
        "reputation",
        "governance-design"
      ],
      "scope_conditions": [
        "DAO of DAOs two token architecture"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 61
    },
    {
      "id": "kaal:claim:3799320-030:source-passage",
      "type": "SourcePassage",
      "text": "1. the non-fungible reputation tokens give DAO of DAOs members voting rights, and 2. fungible reputation salary tokens allow DAO of DAOs members to earn a fungible salary in proportion to their non-fungible reputation tokens.",
      "text_sha256": "fcf3008f9afbd5f1ebf868096f0110a6d1cee57c1e93e2638eccaa3bf3c1b8c6",
      "source_sha256": "c3dff852f2d3f04718c829a24189309a7db4d92d84f6045d3d4f562d87c03e63",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:3799320-031",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/3799320-031",
      "text": "Paying members indirectly, through a fungible stable salary proportional to non fungible reputation, removes corruptive elements and makes the governance design more attack resistant and more stable over the long run.",
      "claim_type": "mechanism",
      "topics": [
        "risk-and-incentives",
        "consensus-and-security",
        "tokenomics",
