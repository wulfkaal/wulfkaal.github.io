      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 16
    },
    {
      "id": "kaal:claim:2957645-011:source-passage",
      "type": "SourcePassage",
      "text": "Rather than acquiring necessary information after rules have emerged as suboptimal, feedback effects help increase the availability of relevant information for rulemaking ex ante and anticipate necessary revisions",
      "text_sha256": "0dfc66a6e83014277322e25030b91a4581501e59c0bb68220d6372d63511814e",
      "source_sha256": "250b10782a5ea5dece9235a7f711aee408feaf36f2e78e310d589b5ee6304be2",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:2957645-012",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/2957645-012",
      "text": "Anticipatory regulation, which uses institution-specific and timely information together with feedback effects to create new rules, can minimize costly and suboptimal ex-post trial-and-error experimentation with stable and presumptively optimal rules.",
      "claim_type": "mechanism",
      "topics": [
        "institutional-design",
        "dynamic-regulation"
      ],
      "scope_conditions": [
        "institution-specific and timely information is actually available to rulemakers"
