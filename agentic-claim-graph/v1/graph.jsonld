    },
    {
      "id": "kaal:claim:1806252-013:source-passage",
      "type": "SourcePassage",
      "text": "Hedge funds are not counterparties in government bailouts, but if banks get bailed out, they may have less incentive to monitor their hedge fund lending activities or other hedge fund-related business.",
      "text_sha256": "a0483a3f4c1f7c85f1aac2f99c7825476abc884380a771ff4f0f17e0a921c110",
      "source_sha256": "3343ebfe05a925c3d1a75625c4b351ccff515c50819a48d155804daacf01429d",
