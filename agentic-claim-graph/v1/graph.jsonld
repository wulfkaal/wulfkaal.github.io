      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "evidenced",
      "relevance_score": 10
    },
    {
      "id": "kaal:claim:2715083-017:source-passage",
      "type": "SourcePassage",
      "text": "Alternative funds generally cannot generate the same absolute returns as hedge funds (Hasanhodzic & Lo (2007) and McCarthy (2015)), which is attributed by some to the lighter touch regulation and better incentives applicable to hedge funds.",
      "text_sha256": "915dcc490021eaf91b0ab2e0e67acf4fba2a27eb8262db0d4bb43627ce9076c8",
      "source_sha256": "b5c92186260d4a8499a14f81ee24ace093b24e7740af3effcd1c526fa4fa221e",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:2715083-019",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/2715083-019",
      "text": "The traditional mutual fund governance model, in which one board serves multiple discrete funds within a sponsor's group, is subject to significant oversight challenges.",
