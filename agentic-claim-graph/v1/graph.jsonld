      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:3799320-031",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/3799320-031",
      "text": "Paying members indirectly, through a fungible stable salary proportional to non fungible reputation, removes corruptive elements and makes the governance design more attack resistant and more stable over the long run.",
