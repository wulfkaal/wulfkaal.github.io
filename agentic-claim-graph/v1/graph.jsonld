      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 33
    },
    {
      "id": "kaal:claim:3782201-023:source-passage",
      "type": "SourcePassage",
      "text": "But that technical design flaw was not its most serious problem. The system would have eventually failed more spectacularly, because it was designed poorly on other levels.",
      "text_sha256": "5cd22306e7c5c6fabc394b6eec4309cb487efe1aaeeb99a18abde47d85addff3",
      "source_sha256": "bedf7bcfbb7a9b0112b5848cb0d941b1d41f330dafeee0143a30ff5e8aa53700",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:3782201-025",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/3782201-025",
      "text": "New DAO proposals appear almost quarterly in the 2020s and most fail because of a lack of decentralized governance solutions.",
      "claim_type": "failure",
      "topics": [
        "dao",
        "governance-design",
        "decentralization",
        "economics"
      ],
      "scope_conditions": [],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
