      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/2808132-028",
      "text": "The collective action problem of rulemaking, the problems of trial-and-error rulemaking, and the problems of regulatory cycles derive largely from the nature of stable and presumptively optimal rules themselves, not from unrelated institutional defects.",
      "claim_type": "mechanism",
      "topics": [
        "institutional-design",
        "dynamic-regulation"
      ],
      "scope_conditions": [
        "regulatory regimes whose outcomes are stable rather than adaptive"
