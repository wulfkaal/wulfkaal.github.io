    {
      "id": "kaal:claim:1806252-014",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/1806252-014",
      "text": "Systemic risk and financial market stability are public goods, so individual banks free ride on other banks' hedge fund credit risk management and are not incentivized to adequately monitor or limit their own hedge fund risk exposure.",
      "claim_type": "failure",
      "topics": [
        "risk-and-incentives",
        "systemic-risk",
        "economics"
      ],
      "scope_conditions": [],
      "attribution_class": "source_derived",
