      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "evidenced",
      "relevance_score": 11
    },
    {
      "id": "kaal:claim:2998033-017:source-passage",
      "type": "SourcePassage",
      "text": "While the value of Bitcoin in 2013 under $20 and its value appreciated to over $1200 in 2017, in the past four years, the IRS has only received around 900 Form 8949 that would indicate some gain or loss from cryptocurrencies.",
      "text_sha256": "94df739b27b1f10b9ded5518a7d00221d10a768aa8cd9c31728e5167cc346e2e",
      "source_sha256": "aafb1be3c25cd33da477d759df9ca2f856f0a8fe133d6396da2e75d0af573dbd",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:2998033-020",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/2998033-020",
      "text": "Blockchain removes the reconciliation problem in private equity administration by letting every party to a deal view a single compiled version of the transaction and its associated data, instead of reconciling multiple copies of deal documents.",
      "claim_type": "mechanism",
      "topics": [
        "private-funds",
        "reputation",
        "disclosure"
      ],
      "scope_conditions": [
        "illustrated by the February 2017 Northern Trust and IBM private equity administration partnership"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "evidenced",
      "relevance_score": 36
    },
    {
      "id": "kaal:claim:2998033-020:source-passage",
      "type": "SourcePassage",
      "text": "the blockchain program announced by Northern Trust and IBM allows all involved parties in an equity deal to look at a single compiled version of the transaction and all other data relating to the deal.",
      "text_sha256": "d24eded09805e82ad52c580698c94eca8d005c12e489888b2b4b9609ec9b7963",
