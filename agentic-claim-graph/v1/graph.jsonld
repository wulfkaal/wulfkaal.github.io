    },
    {
      "id": "kaal:claim:4755632-041:source-passage",
      "type": "SourcePassage",
      "text": "combination of decentralized governance and gamification of micro task work, ALE Platform ensures that gamification techniques do not compromise the quality and accuracy",
      "text_sha256": "a9cfae355be8185742689a4804abe489c9ab369c543ac6521750c388e0a86005",
