    },
    {
      "id": "kaal:claim:3709041-028:source-passage",
      "type": "SourcePassage",
      "text": "Such blockchain title data can serve as collateral for accessing credit or verifying identities which is often a challenging and prohibitive requirement for accessing both financial and non-financial services.",
      "text_sha256": "e54aff26d98fed227991b2f702568c5abec860b315bd6490c235179b5349e5bd",
      "source_sha256": "5216a7bca45a48e3bef11ec524936e66af737c0fd66271e9f6866dc20a4482cc",
