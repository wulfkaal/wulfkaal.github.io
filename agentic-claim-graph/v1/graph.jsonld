      "source_sha256": "2d73609d95ddb1573acc2a9e7af617fbe6283d6e591deb6317f6d5d804517c62",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:5583610-005",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/5583610-005",
      "text": "Negotiated settlements that hand activists board seats risk entrenching incumbents, whereas LER's consumptive utilities are designed to produce consensus and alignment without ceding board representation.",
      "claim_type": "failure",
      "topics": [
        "corporate-governance"
      ],
      "scope_conditions": [
