    {
      "id": "kaal:claim:3002908-005:source-passage",
      "type": "SourcePassage",
      "text": "More specifically, jurisdiction over the public blockchain does not exist within the present doctrinal infrastructure for jurisdiction. In practice, the blockchain itself cannot be regulated or governed because it is decentralized and autonomous.",
      "text_sha256": "3f989746c7cfef8531257bc7cbba9655b9142d79c614ecbef991d62d7162ed94",
      "source_sha256": "06a7b61e75f905ee07e422e875d83a65c5033a248a6e05a213523b034e5db534",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:3002908-009",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/3002908-009",
      "text": "The immutability and permanent recording built into blockchain technology may be the root of legal difficulties in European countries that recognize a right to be forgotten or comparable privacy rights.",
      "claim_type": "failure",
      "topics": [
