      "source_sha256": "abcef529c7200261c59eec43018375b3b26e3186239fb9d002bacc298dba26ff",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:2957645-001",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/2957645-001",
      "text": "Contingent capital securities are a largely overlooked dynamic regulatory mechanism, and their regulatory value lies in their capacity to generate feedback effects, optimized timing, and improved information for regulation.",
      "claim_type": "design",
      "topics": [
        "contingent-capital",
        "dynamic-regulation",
        "institutional-design"
      ],
      "scope_conditions": [],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
