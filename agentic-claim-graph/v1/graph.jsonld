      "id": "kaal:claim:7261018-019",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/7261018-019",
      "text": "Unanimity is a cascade-consistent quantity: unusually frequent unanimous verdicts are consistent with validators discounting private information in favor of perceived group consensus, but they do not uniquely identify the Banerjee and Bikhchandani-Hirshleifer-Welch mechanism, with Holmstr\u00f6m\u2019s free-riding equilibrium supplying the complementary reading that leaning on the apparent consensus is what costly evaluation effort converges to when its product is shared.",
      "claim_type": "condition",
      "topics": [
        "economics",
        "consensus-and-security",
        "ai-and-agents"
      ],
      "scope_conditions": [
        "interpretation of unanimity in the completed controlled study"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
