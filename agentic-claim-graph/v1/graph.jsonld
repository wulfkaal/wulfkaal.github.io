      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 19
    },
    {
      "id": "kaal:claim:1998455-026:source-passage",
      "type": "SourcePassage",
      "text": "Harmonization and coordination can help facilitate experimentation and a learning process, but experimentation is probably most effective when several different approaches can be tried simultaneously in dif- ferent jurisdictions.",
      "text_sha256": "b1f1c3c7953a86fdc9a413900366e43ea63c4b7c9bdec379e43774b90964a961",
