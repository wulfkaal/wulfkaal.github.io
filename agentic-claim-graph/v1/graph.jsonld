      "relevance_score": 61
    },
    {
      "id": "kaal:claim:3266953-018:source-passage",
      "type": "SourcePassage",
      "text": "Block propagation in the Semada platform is facilitated by staking reputation, not a fungible currency as in PoS. Accordingly, the consensus algorithm is called Semada Proof of Reputation (PoR).",
      "text_sha256": "9e795ac374b5d389174b17b4148106c2a3c4c3180f2618e3254a114230f1d548",
      "source_sha256": "781758dea356e55d79c73ad7f1debe7c83de398bd1cd9e0a9a6c2802f276b4c0",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:3266953-021",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/3266953-021",
      "text": "Because Semada's Anchor Protocol uses reputation scores as a non fungible currency to qualify for block propagation, the resulting proof of reputation consensus is attack resistant, fully decentralized, scalable, and open to evolutionary protocol upgrades.",
      "claim_type": "design",
      "topics": [
        "reputation",
        "consensus-and-security"
      ],
      "scope_conditions": [
        "reputation scores that cannot be transferred"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 61
    },
    {
      "id": "kaal:claim:3266953-021:source-passage",
      "type": "SourcePassage",
      "text": "Unlike traditional PoS, PoR, e.g. Semada's Anchor Protocol, uses reputation scores as a non-fungible currency to qualify for block propagation. As such, the Anchor protocol (PoR) is attack resistant, fully decentralized, scalable and allows evolutionary protocol upgrades.",
      "text_sha256": "86c83c1d7e88ca47519c4e6763be98e9caff83c5a720e595b2b197d3f49f7523",
