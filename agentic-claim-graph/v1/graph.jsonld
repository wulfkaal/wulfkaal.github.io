    {
      "id": "kaal:claim:4685567-025:source-passage",
      "type": "SourcePassage",
      "text": "The use of weighted reputation voting has key advantages over other WEB2 and WEB3 one-token-one-vote voting mechanisms. It aligns incentives for donor community members individually and at the same time calibrates their incentives with the overall community.",
      "text_sha256": "061879fc5ce7cdfaa4f0862b8a09008e5c9d0d9781b8a9cb4b1bcdb67f424b4e",
