      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "evidenced",
      "relevance_score": 78
    },
    {
      "id": "kaal:claim:7314479-027:source-passage",
      "type": "SourcePassage",
      "text": "Trust is architectural rather than reputational, and enforcement is Core-mediated regardless of what a component claims about itself. No reputation input reaches the enforcement path because no reputation layer exists yet. The requirement is therefore not violated. It is unguarded.",
      "text_sha256": "329a917cc1a4dfe4a80aa1b4b3a01738cb9cb3fd4a2c972de060133bb620e99c",
      "source_sha256": "debace24a155ae924a155b1fafe98856d98cf83689feff2f87a32f1c06171ce6",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
