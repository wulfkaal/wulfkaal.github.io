    {
      "id": "kaal:claim:6269518-001",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/6269518-001",
      "text": "Under existing citation-weighted reputation formulations, rational agents face a direct financial disincentive to cite prior contributions, because PageRank-derived value allocation transfers economic reward from the citing agent to the cited agent.",
