      "source_sha256": "87fb1be89d2661967ed2b0b673fe26448ded3bc3119b122177a4fc13ae5c085c",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:4685567-038",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/4685567-038",
      "text": "Impact certificates are an incomplete measure of expertise: they capture impact success in fungible economic terms without referring to the expertise actually developed by individual project community members or by the project as a collective, which is why WEB3 community software is needed for expertise tracking.",
