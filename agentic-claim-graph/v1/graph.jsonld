    },
    {
      "id": "kaal:claim:6244278-023:source-passage",
      "type": "SourcePassage",
      "text": "They are stewards: not because they were programmed to be, but because the institutional architecture makes stewardship the rational strategy for agents with deep accumulated stake.",
      "text_sha256": "419809576c116a0c113159ece3b0c5eb8133dbac2d44413207c5557c0ee89daa",
