    },
    {
      "id": "kaal:claim:2273857-036",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/2273857-036",
      "text": "The partial repeal of Section 404 of Sarbanes-Oxley through the Dodd-Frank Act illustrates that broad rules enacted during times of political expediency are often later retracted.",
      "claim_type": "empirical",
      "topics": [
