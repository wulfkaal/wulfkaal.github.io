    },
    {
      "id": "kaal:claim:5583610-005:source-passage",
      "type": "SourcePassage",
      "text": "Unlike negotiated settlements that, in granting activists board seats, risk incumbent entrenchment,15 LERs incentivize consensus and alignment through LER's consumptive utilities, thus, reducing conflict while enhancing shareholder engagement.",
      "text_sha256": "4b0bc31051fda14dc51aaefd76dd34bfd601236dedc551e427efed7c9a13e3c2",
      "source_sha256": "2d73609d95ddb1573acc2a9e7af617fbe6283d6e591deb6317f6d5d804517c62",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:5583610-008",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/5583610-008",
      "text": "Reward accrual scales with holding duration, for example thirty to ninety day windows, which encourages prolonged ownership in the same way DeFi liquid staking yields encourage retention, but without locking up the shareholder's ability to sell.",
      "claim_type": "mechanism",
      "topics": [
        "institutional-design"
      ],
      "scope_conditions": [
        "rewards keyed to verified holding periods"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 21
    },
    {
      "id": "kaal:claim:5583610-008:source-passage",
      "type": "SourcePassage",
      "text": "Similar to how DeFi liquid staking leverages yields to encourage retention, these payments increase over time based on holding durations (for example, 30\u201390 days), encouraging prolonged ownership without locking up liquidity.",
      "text_sha256": "bf42d610987a65930019a46bb1ef69440f39b158695639adbecd019b8b4f5a06",
      "source_sha256": "2d73609d95ddb1573acc2a9e7af617fbe6283d6e591deb6317f6d5d804517c62",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
