    },
    {
      "id": "kaal:claim:5225296-011",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/5225296-011",
      "text": "Reputation functions as a social incentive that complements monetary reward and sustains cooperation in trustless environments, a behavioral mechanism unavailable to purely stake-weighted consensus systems.",
