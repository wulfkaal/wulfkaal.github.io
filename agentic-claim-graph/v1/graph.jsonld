    {
      "id": "kaal:claim:4900880-031",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/4900880-031",
      "text": "Quantum computing will displace job roles built on repetitive and manual tasks, but that displacement is offset by new roles in quantum programming, algorithm design, and quantum cryptography that did not previously exist.",
      "claim_type": "predictive",
      "topics": [
        "consensus-and-security",
        "citation-and-knowledge"
      ],
      "scope_conditions": [],
