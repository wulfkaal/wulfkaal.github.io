    {
      "id": "kaal:claim:3782205-025",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/3782205-025",
      "text": "Decentralized governance design must address all three branches: executive governance as automated policing, legislative governance as non-automated protocol development, and judicial governance as both automated and non-automated dispute resolution.",
