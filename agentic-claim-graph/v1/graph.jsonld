    {
      "id": "kaal:claim:6655138-003",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/6655138-003",
      "text": "Because the agent action space in HDCA is closed and workers only select among existing postings, the architecture collapses to the Neoclassical labor market with reputation weighting, the very framework whose expiration the author's companion paper demonstrates.",
