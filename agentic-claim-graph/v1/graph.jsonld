    },
    {
      "id": "kaal:claim:1558614-019",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/1558614-019",
      "text": "Because the Aufsichtsrat owes its duty of loyalty to the firm rather than to shareholders alone, and because non shareholder constituencies such as employees and creditors are more risk averse than diversified shareholders, German supervisory boards may take a more conservative attitude toward risk than U.S. shareholder oriented boards.",
      "claim_type": "mechanism",
      "topics": [
        "corporate-governance",
        "governance-design",
        "risk-and-incentives"
      ],
      "scope_conditions": [
        "German courts treat the duty as protecting the interests of the firm, not only shareholders",
        "reinforced by codetermination"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 20
    },
    {
      "id": "kaal:claim:1558614-019:source-passage",
      "type": "SourcePassage",
      "text": "The Aufsichtsrat's legal duty of loyalty to the firm as distinct from its shareholders thus may dictate a more conservative attitude toward risk than that of a shareholder oriented board of di- rectors in the United States.",
      "text_sha256": "525811b45eb4453e9a8139cca95bfd3b4aa4f71dcc555b5cfaa391c5b1e4fa5c",
      "source_sha256": "e898211630f4116879329d6de8397523dca5b066864147421aa5cbc7429dc83b",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:1558614-020",
