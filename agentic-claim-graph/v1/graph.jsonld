    {
      "id": "kaal:claim:2273857-053",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/2273857-053",
      "text": "The core problem for financial regulation is timing: governance improvements are not enacted before crises when they are most needed, because the collective action problem makes financial regulation mostly reactive and tied to business cycles.",
      "claim_type": "failure",
      "topics": [
        "institutional-design",
        "regulatory-failure"
      ],
      "scope_conditions": [],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
