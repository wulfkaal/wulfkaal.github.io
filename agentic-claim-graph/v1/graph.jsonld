      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 28
    },
    {
      "id": "kaal:claim:4900880-031:source-passage",
      "type": "SourcePassage",
      "text": "However, this displacement is counterbalanced by the creation of new opportunities in emerging fields such as quantum programming, algorithm design, and quantum cryptography.",
