      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:3981021-026",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/3981021-026",
      "text": "Every CHARITYxDAO decision runs through a two vote model: a loosely coupled sentiment vote with no reputation at stake, followed by a tightly coupled final vote with reputation at stake.",
      "claim_type": "design",
      "topics": [
        "reputation",
        "governance-design"
      ],
      "scope_conditions": [
        "all CHARITYxDAO governance decisions"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "asserted",
      "relevance_score": 54
    },
    {
      "id": "kaal:claim:3981021-026:source-passage",
      "type": "SourcePassage",
      "text": "i. Two vote model a) loosely coupled (sentiment) vote (no reputation at stake), b) tightly coupled (final) vote (reputation at stake):",
      "text_sha256": "c0f4f912002eb678ab2d1fe4574e0a135b9f60213dc38ac80038c3d044d57dc9",
      "source_sha256": "9d8bc78d119c780c96c89ce3e820f4ac8b037d39b3ade59feb4e40d46b048288",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:3981021-027",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/3981021-027",
      "text": "Because voting associates can see the sentiment vote outcomes and who staked what reputation before the binding vote, it is reasonable to expect that the overwhelming majority of final tightly coupled votes will end in unanimity on the issue at hand.",
      "claim_type": "predictive",
      "topics": [
        "consensus-and-security",
        "governance-design",
        "reputation"
      ],
      "scope_conditions": [
        "two vote designs where sentiment results are visible before the binding vote"
