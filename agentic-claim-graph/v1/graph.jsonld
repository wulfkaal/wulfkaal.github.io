    },
    {
      "id": "kaal:claim:5225296-020:source-passage",
      "type": "SourcePassage",
      "text": "compress proof generation from seconds to milliseconds while preserving constant-time verification, aligning with SPoS's need for rapid governance operations under microsecond-scale reputation updates",
