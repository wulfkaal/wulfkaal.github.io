      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "asserted",
      "relevance_score": 26
    },
    {
      "id": "kaal:claim:4900878-034:source-passage",
      "type": "SourcePassage",
      "text": "Research into quantum-resistant cryptographic algorithms will be crucial to safeguard blockchain systems against potential threats posed by quantum computing.",
