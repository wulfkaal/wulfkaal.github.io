    {
      "id": "kaal:claim:6607458-026",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/6607458-026",
      "text": "Because supply of any specific realization is unbounded while the quality of the generative distribution is bounded, markets for computative outputs will organize around access to generative capacity, pricing will be access-based rather than per-unit, and antitrust analysis should attach to generative capacity rather than downstream outputs.",
      "claim_type": "predictive",
      "topics": [
        "reputation",
        "economics"
      ],
      "scope_conditions": [
        "holds under the computative primitive"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 39
    },
    {
      "id": "kaal:claim:6607458-026:source-passage",
      "type": "SourcePassage",
      "text": "This implies that markets for computative outputs will organize around access to generative capacity rather than around the exchange of specific outputs, that pricing will be access-based rather than per-unit, and that competition and antitrust analysis should attach to generative capacity",
      "text_sha256": "354dd0fde27cce6d4cc3bef87d611e5b57f5c2f9bb36ef9f4b57be7490db4ef3",
      "source_sha256": "75cca35350378eb8904866d068b5d2f3e1504629e6031457ce6c12152a88e3e8",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:6607458-030",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/6607458-030",
      "text": "The AI alignment problem is, within this framework, a foundational policy problem of Computative Economics rather than an adjacent engineering concern, because objective function governance determines what agents generate toward.",
