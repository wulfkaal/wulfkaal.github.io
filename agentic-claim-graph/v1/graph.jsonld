    {
      "id": "kaal:claim:3782201-023",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/3782201-023",
      "text": "The re entrancy programming bug was not the 2016 DAO's most serious problem; the system would eventually have failed more spectacularly because it was designed poorly on other levels.",
      "claim_type": "failure",
      "topics": [
        "dao",
        "governance-design",
        "smart-contracts"
      ],
      "scope_conditions": [],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
