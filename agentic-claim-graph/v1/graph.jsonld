    {
      "id": "kaal:claim:2740477-004",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/2740477-004",
      "text": "Dynamic regulation is defined as the study of regulatory phenomena in relation to both preceding and succeeding events, using institution specific and decentralized information to generate feedback effects that support anticipatory rulemaking.",
      "claim_type": "definitional",
      "topics": [
        "dynamic-regulation",
        "institutional-design",
        "decentralization"
      ],
      "scope_conditions": [],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "asserted",
      "relevance_score": 20
    },
    {
      "id": "kaal:claim:2740477-004:source-passage",
      "type": "SourcePassage",
      "text": "The theory of dynamic regulation conceptualizes the study of regulatory phenomena in relation to preceding and succeeding events, using institution-specific and decentralized information to facilitate feedback effects for anticipatory rulemaking.",
      "text_sha256": "f711d717876ac299755302b77a5d8b424f354492c91db0b1bc88ef8f22267535",
      "source_sha256": "c72871b76fa2ad5a8a69ee8d3defc8f64e624be9052ce763e79cf6c58883f726",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:2740477-005",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/2740477-005",
      "text": "Venture capital can function as a dynamic regulatory supplement for disruptive innovation because venture capitalists' financial allocations to innovative projects generate feedback that regulators can use.",
      "claim_type": "design",
      "topics": [
        "innovation",
        "dynamic-regulation",
        "institutional-design"
      ],
      "scope_conditions": [],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 16
    },
    {
      "id": "kaal:claim:2740477-005:source-passage",
      "type": "SourcePassage",
      "text": "We show that venture capital can function as a dynamic regulatory supplement for disruptive innovation. Venture capital's financial allocations to innovative projects can provide feedback for dynamic regulation of disruptive innovation.",
      "text_sha256": "7037d17c86dbb0234ac3a7d852381c6be1253ea376b183f9a87e9686cbee5150",
      "source_sha256": "c72871b76fa2ad5a8a69ee8d3defc8f64e624be9052ce763e79cf6c58883f726",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:2740477-007",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/2740477-007",
      "text": "Artificial intelligence cannot be held personally liable for damage it causes because national and international law do not currently recognize it as a subject of law, so compensation must be forced through existing provisions never designed for it.",
      "claim_type": "failure",
      "topics": [
        "ai-and-agents",
        "law-and-legal-systems"
      ],
      "scope_conditions": [
        "current state of national and international law",
        "damage caused by autonomous AI"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 35
    },
    {
      "id": "kaal:claim:2740477-007:source-passage",
      "type": "SourcePassage",
      "text": "However, national and international law do not (currently) recognize AI as a subject of law. Without legal personality, AI cannot be personally liable for damages.",
      "text_sha256": "66ffffd8a4be25e3f06ec89cc4e4fda770c51dcff91c19cacee686ae50ee81aa",
      "source_sha256": "c72871b76fa2ad5a8a69ee8d3defc8f64e624be9052ce763e79cf6c58883f726",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:2740477-024",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/2740477-024",
      "text": "Accepting suboptimal rules temporarily buys rule certainty and predictability but guarantees a later cycle of revision, amendment, and repeal, so rulemakers trade short term certainty for a costly correction process.",
      "claim_type": "mechanism",
      "topics": [
        "institutional-design"
      ],
      "scope_conditions": [
        "rulemakers knowingly accept suboptimalities tied to unknown future contingencies"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 10
    },
    {
      "id": "kaal:claim:2740477-024:source-passage",
      "type": "SourcePassage",
      "text": "Temporary acceptance of suboptimal rules increases temporary rule certainty and predictability, but it also precipitates the inevitable need for rule revision, amendments, and repeals",
      "text_sha256": "85ae243e915ebcc6e63ef84585b315ae6779c2d3263cd29ce0db86760ba1041e",
      "source_sha256": "c72871b76fa2ad5a8a69ee8d3defc8f64e624be9052ce763e79cf6c58883f726",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:2740477-027",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/2740477-027",
      "text": "The collective action problem of rulemaking, the problems of trial and error rulemaking, and regulatory cycles all derive largely from the nature of stable and presumptively optimal rules rather than from independent causes.",
      "claim_type": "mechanism",
      "topics": [
        "institutional-design"
      ],
      "scope_conditions": [],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 8
    },
    {
      "id": "kaal:claim:2740477-027:source-passage",
      "type": "SourcePassage",
      "text": "The collective action problem of rulemaking, problems associated with trial-and-error rulemaking, and problems associated with regulatory cycles derive largely from the nature of stable and presumptively optimal rules.",
      "text_sha256": "9fb14011ae98c988c0caa52b5fb45a4a6ac30c6402c4368ecca659ffb35dc686",
      "source_sha256": "c72871b76fa2ad5a8a69ee8d3defc8f64e624be9052ce763e79cf6c58883f726",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:2740477-029",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/2740477-029",
      "text": "Dynamic regulatory tools let rulemakers adapt to regulatory contingencies as they arise, because feedback effects deliver relevant, timely, decentralized, and institution specific information ex ante.",
      "claim_type": "mechanism",
      "topics": [
        "institutional-design",
        "dynamic-regulation"
      ],
      "scope_conditions": [
        "feedback processes are in place within the regulatory framework"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 22
    },
    {
      "id": "kaal:claim:2740477-029:source-passage",
      "type": "SourcePassage",
      "text": "Dynamic regulatory tools as a regulatory supplement enable rulemakers to adapt to regulatory contingencies if and when they arise because feedback effect provides relevant, timely, decentralized, and institution-specific information ex-ante.",
      "text_sha256": "d900d29b5fd640292c0798a53ba15c085d6a62c437ac5742a376ff0c1589d271",
      "source_sha256": "c72871b76fa2ad5a8a69ee8d3defc8f64e624be9052ce763e79cf6c58883f726",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:2740477-030",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/2740477-030",
      "text": "Regulation is mostly reactive and follows business cycles rather than preempting crises, because of the collective action problem of regulation, path dependencies, and political inertia, so rules arrive when governance improvements are least available.",
      "claim_type": "failure",
      "topics": [
        "institutional-design"
      ],
      "scope_conditions": [],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 16
    },
    {
      "id": "kaal:claim:2740477-030:source-passage",
      "type": "SourcePassage",
      "text": "Because of the collective action problem of regulation, path dependencies, and political inertia, among many other reasons, regulation is mostly reactive, following business cycles and not preemptive, e.g. enacted before crises when governance improvements are most needed.",
      "text_sha256": "b676353097df0b0fd943519ceaa77a6d8d5252bdf90a95586af04c1e5b36523b",
      "source_sha256": "c72871b76fa2ad5a8a69ee8d3defc8f64e624be9052ce763e79cf6c58883f726",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:2740477-031",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/2740477-031",
      "text": "Private rulemakers hold a comparative advantage over public rulemakers because, unlike their public counterparts, they can produce the comparable, decentralized, and institution specific information that rulemaking requires.",
      "claim_type": "mechanism",
      "topics": [
        "dynamic-regulation",
        "decentralization",
        "institutional-design"
      ],
      "scope_conditions": [],
