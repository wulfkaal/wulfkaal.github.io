    },
    {
      "id": "kaal:claim:5225296-010:source-passage",
      "type": "SourcePassage",
      "text": "Recent studies of on-chain governance in DAOs suggest that such systems can outperform traditional models in responsiveness, provided they incorporate robust anti-collusion measures\u2014a challenge SPoS addresses through its cryptographic commitments",
      "text_sha256": "27d4bc691071f6784071f3fc89b307710b73bdf0e5ee51f4cefa107fa2e19867",
      "source_sha256": "b2fec675d906334ad67e13b2d97261dc31e38061022867eb3f9ceadd95f4878d",
