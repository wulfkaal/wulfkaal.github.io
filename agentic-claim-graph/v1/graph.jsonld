    },
    {
      "id": "kaal:claim:3709041-033:source-passage",
      "type": "SourcePassage",
      "text": "Blockchain technology can help ascertain the integrity of clean food for consumers. Consumers increasingly favor genetically unmodified organic food from local and sustainable sources. Yet, it is usually difficult to verify the integrity of products.",
      "text_sha256": "203e3f129de1281a65bb770e3f3e2b1faa6f3ac749ccacd9eacc040cc8d7e6ee",
      "source_sha256": "5216a7bca45a48e3bef11ec524936e66af737c0fd66271e9f6866dc20a4482cc",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:3709041-038",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/3709041-038",
      "text": "The transparency that blockchain offers can address the public's diminishing trust in traditional charities, because blockchain based giving allows donations to be tracked to their destination, kept anonymous or named, and freed of administrative cost or fee.",
      "claim_type": "mechanism",
      "topics": [
        "reputation",
        "disclosure"
      ],
      "scope_conditions": [],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
