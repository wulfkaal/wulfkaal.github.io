    {
      "id": "kaal:claim:5541658-028:source-passage",
      "type": "SourcePassage",
      "text": "Web3 systems offer significant improvements in this context.",
      "text_sha256": "1c3a35f148a200bf8803d6ffcdf5d3df1b489bc02b0463bc4f2e36fddeb29822",
      "source_sha256": "e543a2d698fcd522d4d02e034cc9ee1344d0015d2c824b40b9e05ab7c0728c60",
      "locator_status": "exact_quote_without_page_locator"
