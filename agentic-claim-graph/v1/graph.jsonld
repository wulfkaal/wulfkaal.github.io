    },
    {
      "id": "kaal:claim:2273857-036:source-passage",
      "type": "SourcePassage",
      "text": "The partial repeal of section 404 of SOX70 via the Dodd-Frank Act is another example that illustrates how broad rules enacted during times of political expediency are often later retracted.",
      "text_sha256": "eb686b00912b1600799ac379d23ab9a0323017d02a0773da51ee804e35170755",
