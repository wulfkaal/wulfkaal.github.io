    {
      "id": "kaal:claim:2097160-006",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/2097160-006",
      "text": "Analyzing executive compensation as a single contract between an executive agent and a corporate principal fails, because it ignores the informal relational element of the principal agent relationship that often overshadows the legal terms of the agreement.",
      "claim_type": "failure",
