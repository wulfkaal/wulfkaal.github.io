    },
    {
      "id": "kaal:claim:2959730-042:source-passage",
      "type": "SourcePassage",
      "text": "The paper has illustrated that the rise of blockchain applications in private investment funds can exacerbate the already changing fee structure of the industry.",
      "text_sha256": "0654086d932decbd4316ddaf44c8bc74d9238f05aa82de365ba5b3f6f69a9255",
      "source_sha256": "ebd86972d8817b0c1c80326ae5564476983cedba3f258ff3b2610f156b93fb50",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:2992962-003",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/2992962-003",
      "text": "If the jurisdictional means necessary for conflict resolution mechanisms covering Ethereum blockchain based smart contracting are absent, consumers will mistrust the new technology, and that mistrust can undermine the evolution of the blockchain based crypto economy.",
      "claim_type": "predictive",
      "topics": [
        "reputation",
        "law-and-legal-systems",
        "economics",
        "smart-contracts"
      ],
      "scope_conditions": [
        "Ethereum blockchain based smart contracting"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 41
    },
    {
      "id": "kaal:claim:2992962-003:source-passage",
      "type": "SourcePassage",
      "text": "Not having the required jurisdictional means necessary for conflict resolution mechanisms for Ethereum blockchain-based smart contracting, may invoke consumer mistrust in the new technology. This can then undermine the evolution of the blockchain-based crypto economy.",
      "text_sha256": "60b8e446b31a6226399da3b6ff86ae8f37b36a6f7794621489dcb5c1ce08036b",
      "source_sha256": "80b92e67594394e38af41b769327936833de8e25d6cf3def966a6ba13bc83d17",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:2992962-005",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/2992962-005",
      "text": "Even if every user and supporter of the blockchain and their locations were known, it would still not be possible to exercise jurisdiction in the traditional meaning of the word, because the system operates largely autonomously.",
      "claim_type": "failure",
      "topics": [
        "ai-and-agents",
        "law-and-legal-systems",
        "compliance",
        "decentralization",
        "blockchain"
      ],
