    },
    {
      "id": "kaal:claim:4755632-034",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/4755632-034",
      "text": "A sequenced two-stage vote, an informal community vote that reveals collective wisdom followed by a formal vote in which staked reputation tokens are at risk, gives job posters significant assurance that the reviewed code and the platform report meet the highest available quality standards.",
      "claim_type": "design",
      "topics": [
        "compliance",
        "governance-design",
