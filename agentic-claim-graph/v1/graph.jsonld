      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 32
    },
    {
      "id": "kaal:claim:3373393-028:source-passage",
      "type": "SourcePassage",
      "text": "Decentralized Autonomous Organizations (DAOs) have started to challenge the core believe that governance necessitates agency.",
      "text_sha256": "40eb2c3b31feb5a7e6da2087097b96cfb4f3d3c77470bc5409d02540bb13a419",
      "source_sha256": "4d1424b9ba9aff8a61bc7a0dddd02cded93785e5843685dde76c07dcdb23961e",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:3373393-031",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/3373393-031",
      "text": "The unifying interest of DAO token holders in raising token value means they will voluntarily perform optimization tasks, because doing so is directly in their own interest.",
      "claim_type": "mechanism",
      "topics": [
        "dao",
        "tokenomics",
