      "relevance_score": 14
    },
    {
      "id": "kaal:claim:2957645-001:source-passage",
      "type": "SourcePassage",
      "text": "Contingent capital securities are a largely overlooked dynamic regulatory mechanism.",
      "text_sha256": "313fe0d61ad1e2fb0b8a3d035124841c39a22f76552066836bfde559ca1c7b70",
