      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 58
    },
    {
      "id": "kaal:claim:5095633-033:source-passage",
      "type": "SourcePassage",
      "text": "By establishing a forum of weighted nodes and directed edges, WDAG provides a multi-dimensional view of contributors' work, ensuring that reputation is not limited to a single numeric score.",
      "text_sha256": "4f346581bd883051475f60f6c3edb6fe77745c354e49345386118f2619f60a09",
      "source_sha256": "cbb484711f89bcefc9fc6a5730a1ed0a3f764d7999ad9b6f7d8ea05634c26c63",
