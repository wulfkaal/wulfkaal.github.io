      "source_sha256": "64ea6e8b7cfb3d9a83801eba54f9b87182b842a963273ddab7f2d5305639db73",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:4900880-034",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/4900880-034",
      "text": "Traditional hierarchical organizational structures are too slow to adapt to rapid technological change and stifle innovation through rigid control mechanisms, which is why they are unsuited to governing the quantum economy.",
