      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:3931933-038",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/3931933-038",
      "text": "Governance decisions such as network upgrades follow a simple vote that mints no reputation, yet reputation in the SDAO can still be lost through a governance vote because each vote follows the DEVxDAO MVPR logic moving from loosely coupled to tightly coupled voting.",
      "claim_type": "mechanism",
      "topics": [
        "governance-design",
        "reputation"
      ],
      "scope_conditions": [
        "SDAO governance votes on network upgrades"
      ],
