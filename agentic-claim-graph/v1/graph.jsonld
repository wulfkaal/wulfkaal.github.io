    {
      "id": "kaal:claim:6607458-005",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/6607458-005",
      "text": "Every generation, evaluation, and verification cycle updates the computative agent's internal model, which modifies the generation function available in later cycles; this endogeneity of decision capacity to history has no analog in the Neoclassical agent.",
      "claim_type": "mechanism",
      "topics": [
        "ai-and-agents"
      ],
      "scope_conditions": [],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 33
    },
    {
      "id": "kaal:claim:6607458-005:source-passage",
      "type": "SourcePassage",
      "text": "Every generation-evaluation-verification cycle updates the agent's internal model, which in turn modifies the generation function available in subsequent cycles. This endogeneity has no analog in the Neoclassical agent, whose preferences and choice rules are fixed.",
      "text_sha256": "ebd1993c2527241042b1a4b8730d3d988c42a1dad18b406224bd578c06b9b4ba",
      "source_sha256": "75cca35350378eb8904866d068b5d2f3e1504629e6031457ce6c12152a88e3e8",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:6607458-010",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/6607458-010",
      "text": "A computative agent is formally a tuple (C, O, M, G, R) of computational resources, objective function, domain model, generation function, and a non-transferable reputation tracking verified generative performance.",
      "claim_type": "definitional",
      "topics": [
        "ai-and-agents",
        "reputation"
      ],
      "scope_conditions": [],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "asserted",
      "relevance_score": 47
    },
    {
      "id": "kaal:claim:6607458-010:source-passage",
      "type": "SourcePassage",
      "text": "A computative agent is characterized by a tuple (C, O, M, G, R), where C denotes the agent's computational resources (a nonnegative real-valued vector representing processing capacity, memory, training data volume, model parameters, and available energy).",
      "text_sha256": "777ca86e0cf3dfa03af93ac97779cd68d5229a02123a5023f61c8265ada99185",
      "source_sha256": "75cca35350378eb8904866d068b5d2f3e1504629e6031457ce6c12152a88e3e8",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:6607458-012",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/6607458-012",
      "text": "In generative exchange a counterparty cannot evaluate the quality of a generative distribution from a single realization, so a verified track record of prior generative outputs is required; reputation performs this function.",
      "claim_type": "mechanism",
      "topics": [
        "reputation",
        "disclosure",
        "defi"
      ],
      "scope_conditions": [
        "applies where the traded good is a realization drawn from a generative distribution"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 31
    },
    {
      "id": "kaal:claim:6607458-012:source-passage",
      "type": "SourcePassage",
      "text": "The counterparty cannot evaluate the quality of the distribution from a single realization. The counterparty needs a track record: a verified history of the agent's generative outputs across prior interactions. Reputation serves this function",
      "text_sha256": "d9788a48c2c5cac841b8588acf19a38986f430195185975c39054bc3be8bc9a3",
      "source_sha256": "75cca35350378eb8904866d068b5d2f3e1504629e6031457ce6c12152a88e3e8",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:6607458-015",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/6607458-015",
      "text": "Contrary to the Hayekian account in which price is the summary statistic that coordinates dispersed knowledge, the coordinating signal in Computative Economics is not a single scalar price but a composite of price, reputation, and verified generative capacity.",
