      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:4529715-037",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/4529715-037",
      "text": "A DAO built on reputation rather than a fungible token, as CRDAO is, makes the 51 percent attack nearly impossible and renders sock puppet attacks technically possible but of little influence.",
      "claim_type": "mechanism",
      "topics": [
        "dao",
        "reputation",
        "governance-design",
        "consensus-and-security"
      ],
      "scope_conditions": [
        "reputation based governance",
        "no fungible governance token"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 69
    },
    {
      "id": "kaal:claim:4529715-037:source-passage",
      "type": "SourcePassage",
      "text": "CRDAO is fairly attack resistant because of its use of reputation. As a result, sock puppet attacks are technically possible, but would have little influence. CRDAO does not appear to have a fungible token, so the 51 percent attack is nearly impossible.",
      "text_sha256": "8d302173760edbaf517c8938bb0dbbca7d6184c6c6b09772e5f772885c22a4c7",
      "source_sha256": "2d71961e8c449afbeaf45ca4f53de8a575d45c77d6960b767d3d1d0874f296b5",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:4685567-025",
