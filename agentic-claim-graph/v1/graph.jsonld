      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:3782220-028",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/3782220-028",
      "text": "The drift into static power relationships is a universal temptation because centralization is efficient, yet centralized governance is provably flawed.",
      "claim_type": "failure",
      "topics": [
        "decentralization",
        "institutional-design",
        "governance-design"
      ],
      "scope_conditions": [
