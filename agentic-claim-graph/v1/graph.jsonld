      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 10
    },
    {
      "id": "kaal:claim:1765901-019:source-passage",
      "type": "SourcePassage",
      "text": "Albeit seemingly without its own common stock trading in the U.S. or the common stock of Volkswagen trading in the U.S., Porsche could be ex- posed to substantial sanctions in the U.S. merely because of swap agreements in which Porsche had no involvement.",
      "text_sha256": "281d23f77b30ca564f170ca3c47aa5c15c41bd0faaaa51733eadf03152421f76",
      "source_sha256": "7b08b8a15f7d72b4eeed41be2d17c20428cb4727269077a6575c5d22e31ecdc5",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:1765901-028",
