    {
      "id": "kaal:claim:2389416-014",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/2389416-014",
      "text": "Most of the 87 strategic funds keep their AUM very close to the $150 million disclosure threshold, oscillating around it rather than moving decisively above or below it.",
      "claim_type": "empirical",
      "topics": [
