    },
    {
      "id": "kaal:claim:2486570-017",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/2486570-017",
      "text": "Business change provisions in non and deferred prosecution agreements can go as far as requiring the entity to fundamentally change its business model or to shut down entire business units.",
      "claim_type": "empirical",
      "topics": [
        "governance-design",
        "corporate-governance",
        "compliance"
      ],
      "scope_conditions": [],
