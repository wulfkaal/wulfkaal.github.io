        "governance-design"
      ],
      "scope_conditions": [
        "listed companies in particular"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 25
    },
    {
      "id": "kaal:claim:3808859-003:source-passage",
      "type": "SourcePassage",
      "text": "Less successful companies often share a myopic and short-term focus on shareholder value maximization that has led to an unhealthy emphasis on firm share price, market valuations, and financial metrics that obscure issues of relevancy.",
      "text_sha256": "0d9fc2e50c1eaf965778b0966e8901cba993cd7e4f14a9fa5f2edf88a7cd4a6f",
      "source_sha256": "304ad25d43b5ecea3158e3a2ca04e6e1e3bd2958e2134e2dcefbfedf3b6f3ab7",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:3808859-008",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/3808859-008",
      "text": "The social media coordination function is still largely flawed because the incentive design underlying social proof is suboptimal; decentralized technology solutions can take over that coordination function and improve it.",
      "claim_type": "failure",
      "topics": [
        "risk-and-incentives",
        "institutional-design",
        "decentralization"
      ],
      "scope_conditions": [
        "applies to social proof metrics such as share counts used as quality proxies"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 28
    },
    {
      "id": "kaal:claim:3808859-008:source-passage",
      "type": "SourcePassage",
      "text": "Because the incentive design for social proof is suboptimal, the social media coordination function is still largely flawed. Decentralized technology solutions, however, can tap into the coordination function that was inaugurated by social media and improve it.",
      "text_sha256": "608fc09d4ac05f28f788748cbed38dc7c45d6fbc284b1e28c55961b5e594e3a6",
      "source_sha256": "304ad25d43b5ecea3158e3a2ca04e6e1e3bd2958e2134e2dcefbfedf3b6f3ab7",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:3808859-020",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/3808859-020",
      "text": "The absence of a centralized authority makes open source projects prone to separation movements, because rival developer cliques form their own belief systems about the direction of development with no authority to resolve the dispute.",
      "claim_type": "failure",
      "topics": [
        "open-source-and-code",
        "consensus-and-security",
        "governance-design",
        "decentralization"
      ],
      "scope_conditions": [
        "contrasted with centralized software projects"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 40
    },
    {
      "id": "kaal:claim:3808859-020:source-passage",
      "type": "SourcePassage",
      "text": "Because no centralized authority decides the direction of development, open source projects are more prone to cliques of developers that develop their own belief system regarding certain aspects of the development process.",
      "text_sha256": "ba0bdb8df0bcbb9c6d6d1d70610fc71061bb4ccc03d34b3fa3b70311febfa895",
      "source_sha256": "304ad25d43b5ecea3158e3a2ca04e6e1e3bd2958e2134e2dcefbfedf3b6f3ab7",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:3808859-021",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/3808859-021",
      "text": "An optimally incentivized democratic decision-making tool would make separation movements in open source less likely, because voters who know the process rewards truth-seeking are more likely to accept an adverse outcome; emerging decentralization technology makes such a tool theoretically feasible.",
      "claim_type": "design",
      "topics": [
        "governance-design",
        "risk-and-incentives",
        "open-source-and-code"
      ],
      "scope_conditions": [
        "conditional on incentive-optimal voting mechanisms being buildable"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "speculative",
      "relevance_score": 27
    },
    {
      "id": "kaal:claim:3808859-021:source-passage",
      "type": "SourcePassage",
      "text": "Perhaps if the open source movement had an optimally incentivized democratic decision-making tool, such separation of interests and development would become less likely.",
      "text_sha256": "caafa894145ecc12d4bd56c6db68c39b3e00931ad0d32abf46cab21efdc5d093",
      "source_sha256": "304ad25d43b5ecea3158e3a2ca04e6e1e3bd2958e2134e2dcefbfedf3b6f3ab7",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:3808859-025",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/3808859-025",
      "text": "The degree of decentralization of an open source project is determined by the degree of hierarchy in its governance: a flat structure with consensus decision-making and no power disparities between developers is the most decentralized form.",
      "claim_type": "definitional",
      "topics": [
        "decentralization",
        "research-methods",
        "governance-design",
        "open-source-and-code",
        "institutional-design"
      ],
      "scope_conditions": [
        "author stipulates this measure for comparing open source projects"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "asserted",
      "relevance_score": 40
    },
    {
      "id": "kaal:claim:3808859-025:source-passage",
      "type": "SourcePassage",
      "text": "The degree of decentralization in open source communities and projects is dictated by the degree of hierarchies in the governance of a given project.",
      "text_sha256": "fa27ccd2ad139aae2aeed5321ebb976c3eb4276bfd32ab78e7ad5828212673d6",
      "source_sha256": "304ad25d43b5ecea3158e3a2ca04e6e1e3bd2958e2134e2dcefbfedf3b6f3ab7",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:3808859-027",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/3808859-027",
      "text": "Meritocratic allocation of power in open source projects is often a fallacy, because rank can reflect timing and one-off contributions, deflation is not built into the perception of merit, and free riding on past reputation is therefore possible.",
      "claim_type": "failure",
      "topics": [
        "reputation",
        "governance-design"
      ],
      "scope_conditions": [
        "applies where rank is awarded on perceived merit and not periodically revisited"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 45
    },
    {
      "id": "kaal:claim:3808859-027:source-passage",
      "type": "SourcePassage",
      "text": "In other words, deflation is not built into the perception of merit and free riding is possible.",
      "text_sha256": "eff6df1202e6dd12737ce2201da1de904dd9b38ffa98c9c294982b2d4f8294e9",
      "source_sha256": "304ad25d43b5ecea3158e3a2ca04e6e1e3bd2958e2134e2dcefbfedf3b6f3ab7",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:3808859-032",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/3808859-032",
      "text": "Growth in connected IoT devices is offset by falling consumer confidence, because the sheer number of devices creates unprecedented cyber security exposure and attacks can be launched by unsophisticated parties at minimal cost with maximal potential damage.",
      "claim_type": "failure",
      "topics": [
        "consensus-and-security",
        "reputation"
      ],
      "scope_conditions": [
        "estimates of 30 to 50 billion connected devices by 2020"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "evidenced",
      "relevance_score": 46
    },
    {
      "id": "kaal:claim:3808859-032:source-passage",
      "type": "SourcePassage",
      "text": "The IoT proliferation is offset by diminished consumer confidence. By the year 2020 the majority of experts estimate that a total of 30 to 50 billion devices will connect to the internet.",
      "text_sha256": "fc51a8ef43595b682422cd4ebeb42b8e01e647f3d43cbd6016b47c202c7051cc",
      "source_sha256": "304ad25d43b5ecea3158e3a2ca04e6e1e3bd2958e2134e2dcefbfedf3b6f3ab7",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:3808859-034",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/3808859-034",
      "text": "People increasingly substitute trust in machines, algorithms, and code for trust in organizations and procedures, but that reliance may be misplaced because the existing internet was designed for hierarchical societal structures on an authoritative hierarchical trust model carrying serious cyber security vulnerabilities.",
      "claim_type": "failure",
      "topics": [
        "reputation",
        "consensus-and-security"
      ],
      "scope_conditions": [],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 52
    },
    {
      "id": "kaal:claim:3808859-034:source-passage",
      "type": "SourcePassage",
      "text": "Peoples' increasing reliance on digitized, coded, and automated replacements of traditional cohesion mechanisms may be misplaced. The existing internet is designed for hierarchical societal structures and with an underlying authoritative and hierarchical trust model.",
      "text_sha256": "68798369136d476b2e5a44ebc733169f6312024af6c038c3cb61a033aa21de1f",
      "source_sha256": "304ad25d43b5ecea3158e3a2ca04e6e1e3bd2958e2134e2dcefbfedf3b6f3ab7",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:3808859-039",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/3808859-039",
      "text": "A truly decentralized public blockchain must satisfy three simultaneous requirements: no points of centralization and corruption, full security at the level of proof of work, and transaction throughput above one hundred thousand transactions per second.",
      "claim_type": "design",
      "topics": [
        "blockchain",
        "consensus-and-security"
      ],
      "scope_conditions": [
        "stated as the requirement for technological decentralization via blockchain"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "asserted",
      "relevance_score": 22
    },
    {
      "id": "kaal:claim:3808859-039:source-passage",
      "type": "SourcePassage",
      "text": "That is, a public blockchain that is not subject to points of centralization and corruption, that is fully secure at the level of proof of work security with a transaction throughput of over one hundred thousand transactions per seconds.",
      "text_sha256": "f7a69fcfff6709490ce7dc5f3b5ee6066ca041433181675a78ec7dd30e23a313",
      "source_sha256": "304ad25d43b5ecea3158e3a2ca04e6e1e3bd2958e2134e2dcefbfedf3b6f3ab7",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:3808859-040",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/3808859-040",
      "text": "Without basic decentralized infrastructure products in place, on-chain governance of blockchains is not possible or is only limitedly possible, and the blockchain ecosystem may not be able to grow without a core decentralized infrastructure such as a functioning public blockchain to build on.",
      "claim_type": "condition",
      "topics": [
        "governance-design",
        "decentralization",
        "blockchain"
      ],
      "scope_conditions": [],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
