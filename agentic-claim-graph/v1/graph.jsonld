    {
      "id": "kaal:claim:6244278-018",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/6244278-018",
      "text": "Reputation that grows through validated contribution and decays through poor judgment operates as a selection mechanism on agent behavior over time: agents that consistently produce high-quality work and honestly evaluate others accumulate reputation, and agents that do not lose it.",
      "claim_type": "mechanism",
      "topics": [
