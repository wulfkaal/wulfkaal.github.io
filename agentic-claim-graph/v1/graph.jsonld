      "confidence": "argued",
      "relevance_score": 50
    },
    {
      "id": "kaal:claim:3949098-040:source-passage",
      "type": "SourcePassage",
      "text": "When reputation takes over part of the role of capital it frees up otherwise locked capital that cannot fully be utilized. Decentralized investment vehicles are able to deploy capital more effectively because reputation staking on deals does not require the deployment of capital.",
