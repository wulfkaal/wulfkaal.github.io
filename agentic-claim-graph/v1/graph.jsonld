    },
    {
      "id": "kaal:claim:3782220-028:source-passage",
      "type": "SourcePassage",
      "text": "we must protect the group from falling into static power rela- tionships. The temptation is universal, because of the efficiency of centralization, but it is provably flawed.",
      "text_sha256": "c2a1d755ec67717488fab13f04827c0789f134060fa350bda6ab4ef312d1a060",
