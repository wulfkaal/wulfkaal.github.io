    {
      "id": "kaal:claim:5583610-004:source-passage",
      "type": "SourcePassage",
      "text": "LER employs smart contracts to distribute consumptive utilities, such as merchant vouchers or platform credits, fostering shareholder loyalty without imposing liquidity constraints.",
