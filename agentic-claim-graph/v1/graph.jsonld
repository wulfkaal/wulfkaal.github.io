    },
    {
      "id": "kaal:claim:2486570-024:source-passage",
      "type": "SourcePassage",
      "text": "the cost of implementing N/DPA governance changes can help counteract lack- ing incentives for boards and management to optimize governance and protect the entity from entering into a N/DPA.",
      "text_sha256": "115cef4f27d3158a4214f318de05dfedb1ec8eeff6884ae38242a1703a7ae3f0",
