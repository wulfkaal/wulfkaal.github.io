    {
      "id": "kaal:claim:3652481-036",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/3652481-036",
      "text": "Paying DevDAO salaries in fungible stable tokens in proportion to members' non fungible reputation scores makes the economic benefit indirect, which removes corruptive elements and makes the governance design more attack resistant and stable over the long run.",
      "claim_type": "mechanism",
      "topics": [
        "risk-and-incentives",
