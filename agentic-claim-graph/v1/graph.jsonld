      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 37
    },
    {
      "id": "kaal:claim:3808852-015:source-passage",
      "type": "SourcePassage",
      "text": "Launched in May 2016, the first DAO was set up as an organization based purely on code and smart contracts. It did not have a conventional corporate structure, no incorporation, and had no physical address or headquarter.",
      "text_sha256": "c400269454e3801b7351168b6a2b7d19cd135bb8bd67c760485ee2becef4aa26",
      "source_sha256": "31e91158fdeefebc2f0be54ebf89751f7cdd4c89ecea932888f5ba9be6b1caba",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
