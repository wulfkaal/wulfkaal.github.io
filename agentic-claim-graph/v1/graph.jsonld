    },
    {
      "id": "kaal:claim:3799320-039:source-passage",
      "type": "SourcePassage",
      "text": "This solves the sockpuppet attack because if a DAO of DAOs member creates 10 accounts with 1 reputation token each, it is the same as 1 account with 10 reputation tokens.",
