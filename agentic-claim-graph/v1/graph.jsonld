    },
    {
      "id": "kaal:claim:4755632-035:source-passage",
      "type": "SourcePassage",
      "text": "\"Reputation Tokens\" are non-transferable tokens that cannot be valued and represent the reputation a member has within the community. They simply mirror a scoreboard.",
      "text_sha256": "8d5c3b88ecdc118f6281f61bac8cf0fa4c3b4ce7799e82d6985a9ce17469a7e0",
