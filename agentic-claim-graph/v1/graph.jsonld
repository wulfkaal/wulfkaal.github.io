      "relevance_score": 49
    },
    {
      "id": "kaal:claim:3125827-024:source-passage",
      "type": "SourcePassage",
      "text": "A healthy expertise will continually have near-unanimous consensus on every evidence-of-work validation pool. This creates an impediment to development.",
