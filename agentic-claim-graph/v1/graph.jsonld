    },
    {
      "id": "kaal:claim:2808132-020:source-passage",
      "type": "SourcePassage",
      "text": "issues.80 Because of the limited scope of regulatory issues and the need for consensus- driven institutional designs, the historically evolved infrastructure for rulemaking could cope with its inherent collective action problems,81 regulatory cycles,82 and trial-and-error",
      "text_sha256": "9d5e51a1512d26eb8c581a2068d209271b48977f9b611ac3c56edbc0b70e04fc",
      "source_sha256": "3515f2317ed9c1d33ae55d70467cdf1f6c4e350065ea6a887d5d7619599ad7d2",
