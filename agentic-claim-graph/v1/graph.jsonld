    },
    {
      "id": "kaal:claim:2273857-061:source-passage",
      "type": "SourcePassage",
      "text": "While prosecutors may not have the necessary expertise to negotiate high level corporate governance changes, such as personnel changes and internal corporate and compliance procedures",
      "text_sha256": "e289dfdfe7190ba65be47d8033a86dd0398854cd2f7804069cc3bb3478fa0441",
      "source_sha256": "e7cb3dea40593135acc99a9b00690138fe01020514ebf388f5140e1b0e59e82a",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:2273857-064",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/2273857-064",
      "text": "Corporate integrity agreements improve corporate governance because the ease of reopened prosecution, increased government scrutiny, and the potential for crippling penalties improve boards' and managements' knowledge of pertinent issues in the institution and its monitoring.",
      "claim_type": "mechanism",
      "topics": [
        "compliance",
        "governance-design",
        "corporate-governance"
      ],
      "scope_conditions": [
        "institution operating under a corporate integrity agreement"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 16
    },
    {
      "id": "kaal:claim:2273857-064:source-passage",
      "type": "SourcePassage",
      "text": "The ease of prosecution, the increased scrutiny by the government, and the potential for crippling penalties can improve boards' and managements' knowledge of pertinent issues in the institution and its monitoring. CIAs can, thus, improve corporate governance.",
      "text_sha256": "19ac167dc90b86fe1fcad6b3915946f3e32d653c3db2a5e26f152d53d6e5abac",
      "source_sha256": "e7cb3dea40593135acc99a9b00690138fe01020514ebf388f5140e1b0e59e82a",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:2317580-006",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/2317580-006",
      "text": "Although CIAs sit outside the formal legal framework that defines fiduciary duties, they belong to the penumbra of extra legal forces that clarifies what is expected of directors.",
      "claim_type": "design",
      "topics": [
        "law-and-legal-systems",
        "governance-design",
        "corporate-governance"
      ],
      "scope_conditions": [
        "fiduciary duty law understood as supplemented by extra legal forces"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 16
    },
    {
      "id": "kaal:claim:2317580-006:source-passage",
      "type": "SourcePassage",
      "text": "While CIAs are outside the traditional legal framework that formally defines fiduciary duties, they fit into the penumbra of extra-legal forces11 that helps to clarify the expectations for directors.",
