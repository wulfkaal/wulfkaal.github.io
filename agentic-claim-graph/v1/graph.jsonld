    },
    {
      "id": "kaal:claim:4755632-037:source-passage",
      "type": "SourcePassage",
      "text": "The reputation score mechanism helps discern malicious actors and simple mistakes. It also protects workers and verifiers from fraudulent requesters and suboptimally designed requests.",
