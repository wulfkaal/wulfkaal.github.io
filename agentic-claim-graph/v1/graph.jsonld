      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:3406323-036",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/3406323-036",
      "text": "Decentralized reputation verification is the backstop for smart contracting: it makes mathematically rigid smart contracts more adjustable for business needs and validates smart contract templates, which raises counterparty trust and removes the need for costly back-testing.",
      "claim_type": "design",
      "topics": [
