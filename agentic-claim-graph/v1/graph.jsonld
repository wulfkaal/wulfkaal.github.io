      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:3799320-030",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/3799320-030",
      "text": "In the bifurcated DAO of DAOs token design, non fungible reputation tokens give members voting rights while fungible reputation salary tokens let members earn a salary in proportion to their non fungible reputation holdings.",
      "claim_type": "design",
      "topics": [
        "tokenomics",
        "reputation",
        "governance-design"
      ],
      "scope_conditions": [
        "DAO of DAOs two token architecture"
