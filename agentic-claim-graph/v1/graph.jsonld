    },
    {
      "id": "kaal:claim:5095633-035:source-passage",
      "type": "SourcePassage",
      "text": "the platform risks reinforcing biases or outdated practices if metrics are insufficiently aligned with changes in societal expectations or regulatory norms.",
      "text_sha256": "d9c4b244364058808db4a45e6010dcc1c0aa164f1c8ee59dbe8f0380088a9828",
      "source_sha256": "cbb484711f89bcefc9fc6a5730a1ed0a3f764d7999ad9b6f7d8ea05634c26c63",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:5095633-036",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/5095633-036",
      "text": "Ocean Protocol's market-driven reputation signal is too indirect: it does not measure individual expertise or annotation consistency, and market forces lag behind real-time shifts in best practices and ethical standards.",
      "claim_type": "failure",
      "topics": [
        "economics",
        "reputation"
      ],
      "scope_conditions": [
        "reputation inferred from price signals and demand rather than direct evaluation"
