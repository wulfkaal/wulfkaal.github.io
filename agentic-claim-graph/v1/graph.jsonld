    },
    {
      "id": "kaal:claim:4755632-036",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/4755632-036",
      "text": "Reputation scores on the ALE Platform balance supply and demand through a two-sided incentive: requesters with lower reputation scores find workers less likely to accept their offers, and workers with low reputation scores are less likely to be retained for micro task work.",
      "claim_type": "mechanism",
      "topics": [
        "reputation",
        "risk-and-incentives",
        "economics"
      ],
      "scope_conditions": [
        "applies to the ALE Platform reputation scoring system"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 47
    },
    {
      "id": "kaal:claim:4755632-036:source-passage",
      "type": "SourcePassage",
      "text": "If requesters have a lower reputation score, workers become less likely to accept requesters' offers. In turn, low reputation scores for micro task workers result in a lower likelihood of retention",
      "text_sha256": "7eb7906e1fc9af9da566bd761cdc6943240a0b59e28c42d5365668087ac812e2",
      "source_sha256": "972ccebf0c06ac1767a9e443bb95942b7670e806a63c25ee817c368a64c8eca8",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:4755632-037",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/4755632-037",
      "text": "The reputation score mechanism helps discern malicious actors from simple mistakes and protects workers and verifiers from fraudulent requesters and suboptimally designed requests, so reputation serves as a bidirectional screening device rather than only a worker rating.",
      "claim_type": "mechanism",
      "topics": [
        "reputation"
      ],
      "scope_conditions": [
        "applies to the ALE Platform"
      ],
      "attribution_class": "source_derived",
