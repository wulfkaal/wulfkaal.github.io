    {
      "id": "kaal:claim:3373393-028",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/3373393-028",
      "text": "Decentralized Autonomous Organizations have begun to challenge the core belief that governance necessitates agency, because blockchain enables the removal of agents as intermediaries through code, peer-to-peer connectivity, crowds, and collaboration.",
      "claim_type": "mechanism",
      "topics": [
        "dao",
        "decentralization",
        "governance-design"
      ],
      "scope_conditions": [],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
