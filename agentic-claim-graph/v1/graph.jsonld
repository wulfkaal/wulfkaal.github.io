    },
    {
      "id": "kaal:claim:7314479-015",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/7314479-015",
      "text": "Authority drift is the failure mode permissions systems are least equipped to detect because every individual check passes while the aggregate operates outside what the user authorized.",
      "claim_type": "failure",
      "topics": [
        "consensus-and-security",
        "governance-design",
        "ai-and-agents"
      ],
      "scope_conditions": [
        "delegation chains under a bounded original consent"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 54
    },
    {
      "id": "kaal:claim:7314479-015:source-passage",
      "type": "SourcePassage",
      "text": "Authority drift is the failure mode that permissions systems are least equipped to detect, because at every individual step the system behaves correctly. Each check passes. The aggregate is nonetheless outside what the user authorized.",
