    },
    {
      "id": "kaal:claim:2273857-030:source-passage",
      "type": "SourcePassage",
      "text": "In the absence of crises, however, the intensity of regulation diminishes because regulators are unable to commit to long-term regulatory strategies and instead use private strategies like self-regulation to overcome resource constraints.",
      "text_sha256": "38f2f5b96c78cb30a689769952ac01a01a02c841df5b23b784a3248f7170338a",
      "source_sha256": "e7cb3dea40593135acc99a9b00690138fe01020514ebf388f5140e1b0e59e82a",
