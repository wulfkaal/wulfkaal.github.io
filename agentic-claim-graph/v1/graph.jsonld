    {
      "id": "kaal:claim:5225296-009",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/5225296-009",
      "text": "Because governance is embedded in the protocol rather than conducted off-chain, SPoS could enact protocol changes in weeks or days where Bitcoin's miner and developer negotiation process takes years.",
      "claim_type": "predictive",
      "topics": [
        "ai-and-agents",
        "institutional-design",
        "governance-design"
      ],
      "scope_conditions": [
        "assumes functioning on-chain governance forums"
