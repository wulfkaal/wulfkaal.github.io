      "confidence": "argued",
      "relevance_score": 54
    },
    {
      "id": "kaal:claim:6607458-032:source-passage",
      "type": "SourcePassage",
      "text": "The delegated-acts and code-of-practice mechanisms adopted under recent artificial-intelligence statutes represent partial steps in this direction but remain tethered to legislative revision cycles that operate at substantially lower frequency than the technology they govern.",
