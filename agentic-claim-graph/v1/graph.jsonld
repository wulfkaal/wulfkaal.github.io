      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:1998455-026",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/1998455-026",
      "text": "Harmonization and coordination can facilitate experimentation and learning, but experimentation is most effective when several different approaches are tried simultaneously in different jurisdictions.",
