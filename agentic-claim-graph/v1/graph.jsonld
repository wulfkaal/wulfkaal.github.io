      "relevance_score": 70
    },
    {
      "id": "kaal:claim:3799320-031:source-passage",
      "type": "SourcePassage",
      "text": "The indirect economic effects remove corruptive elements and make the governance design more attack-resistant and stable in the long run.",
      "text_sha256": "ac5b979f140989559f93b3b8c0c4a30d9b7227c80316903650befd47999d5f77",
