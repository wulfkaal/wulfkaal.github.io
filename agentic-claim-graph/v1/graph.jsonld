      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 58
    },
    {
      "id": "kaal:claim:7314479-020:source-passage",
      "type": "SourcePassage",
      "text": "Reputation may inform discovery, routing, pricing, and allocation. It may never grant permission, enlarge authority, or substitute for an enforcement boundary. This is the first requirement because violating it destroys the others.",
