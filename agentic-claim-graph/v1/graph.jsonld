      "source_sha256": "87fb1be89d2661967ed2b0b673fe26448ded3bc3119b122177a4fc13ae5c085c",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:4685567-039",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/4685567-039",
      "text": "Because reputation merit scores are calculated in an immutable and attack resistant manner, they can be aggregated across the many communities an individual belongs to, producing a constantly evolving WEB3 identity score comparable to a credit score.",
      "claim_type": "definitional",
      "topics": [
        "reputation",
        "consensus-and-security"
      ],
      "scope_conditions": [
        "WEB3 governance identity, distinguished from biometric or KYC proof of physical existence"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 49
    },
    {
      "id": "kaal:claim:4685567-039:source-passage",
      "type": "SourcePassage",
      "text": "scores are calculated in an immutable and attack-resistant manner. Therefore, the scores can be aggregated for an individual who is a member of many different communities. The aggregated score creates a constantly evolving identity score in WEB3 systems that can be compared with a credit score.",
      "text_sha256": "a470f4600862f8ed231ca1307b73a07a70758a31324c0a4469a0d6ce45f2bb1b",
      "source_sha256": "87fb1be89d2661967ed2b0b673fe26448ded3bc3119b122177a4fc13ae5c085c",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
