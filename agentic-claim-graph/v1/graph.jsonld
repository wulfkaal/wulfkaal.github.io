    {
      "id": "kaal:claim:3405660-023",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/3405660-023",
      "text": "Indirect regulation asks banks to fully assess the risk they incur from hedge fund counterparties, but that assessment is often dubious at best because of the opacity of hedge fund activity.",
      "claim_type": "failure",
      "topics": [
        "risk-and-incentives",
        "systemic-risk"
      ],
      "scope_conditions": [
        "banks face opaque hedge fund counterparties"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 11
    },
    {
      "id": "kaal:claim:3405660-023:source-passage",
      "type": "SourcePassage",
      "text": "Regulators who regulate banks' risk management processes are in essence asking banks to fully assess the risks they incur in engaging with hedge funds as their counterparties. That assessment is often dubious at best.",
      "text_sha256": "3de9f651e7145b8e6f549aff78d54c085fb1b69c8e7f0838db64bd55b0b68928",
      "source_sha256": "cf507b1833071765bc13a5605f38c2591582eca85f40869e38b6ff075c04d29d",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:3405660-035",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/3405660-035",
      "text": "Indirect regulation makes ex post opportunism by hedge funds less likely because the financial intermediaries, not just the funds, stand to lose reputation and market position if their counterparty risk evaluation proves insufficient.",
      "claim_type": "mechanism",
      "topics": [
        "reputation",
        "risk-and-incentives"
      ],
      "scope_conditions": [
        "intermediaries face reputational exposure in the market"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 33
    },
    {
      "id": "kaal:claim:3405660-035:source-passage",
      "type": "SourcePassage",
      "text": "ex post opportunism of hedge funds is less likely considering that not only hedge funds but also their financial intermediaries are endangered to lose their reputation and market position in case it transpired that their risk evaluation of a counterparty hedge fund is insufficient",
      "text_sha256": "5982dc8ba98528cd8fd6df9c5c69684d3bcf85c1d299227da8a01b668ee924de",
      "source_sha256": "cf507b1833071765bc13a5605f38c2591582eca85f40869e38b6ff075c04d29d",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:3406323-002",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/3406323-002",
      "text": "Because information flow in decentralized systems is optimized through dynamic feedback effects, such systems mutate and change easily, which makes them more attack resistant and allows them to grow very quickly.",
      "claim_type": "mechanism",
      "topics": [
        "decentralization",
        "institutional-design",
        "consensus-and-security"
      ],
      "scope_conditions": [],
      "attribution_class": "source_derived",
