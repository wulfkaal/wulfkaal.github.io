      "canonical_url": "https://wulfkaal.github.io/claims/3808873-042",
      "text": "A decentralized human backstop to code is a core and often overlooked infrastructure requirement, because without it the immutability of the blockchain and its cryptographic security may not create genuine transactional guarantees or trust between principals and agents in the integrity of their contractual relationship.",
      "claim_type": "design",
      "topics": [
        "smart-contracts",
        "reputation",
        "ai-and-agents",
        "corporate-governance"
      ],
      "scope_conditions": [
