      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 8
    },
    {
      "id": "kaal:claim:1664809-033:source-passage",
      "type": "SourcePassage",
      "text": "It is important to distinguish 'overlapping' from 'conflicting' regulation. Conflicting regulation could violate international law.",
