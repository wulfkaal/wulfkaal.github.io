    {
      "id": "kaal:claim:3962614-033:source-passage",
      "type": "SourcePassage",
      "text": "Through the decentralized governance precedent system, projects that were upvoted by the Whale validation pool and have the highest comparative ROI get more citations in the reputation system and continually enhance the reputation of the whale who sourced and proposed it.",
      "text_sha256": "4b95074f6cba74c1427528be3291a58ceb9eccd1a0ec57a8d98260bfe2377530",
      "source_sha256": "c6e202e77fd08db801f932774026458b94e5d103abf30cb1189fe6a1c5edf391",
