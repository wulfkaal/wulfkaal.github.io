    },
    {
      "id": "kaal:claim:3002908-025:source-passage",
      "type": "SourcePassage",
      "text": "The data analysis in this article suggests that the market for private investment funds who invest in- and utilize blockchain technology appears to be near equally divided between the US and the EU with Russia and China playing a significant role.",
      "text_sha256": "e3017a11d4cba6039113f78ded2615b882744fff4db65fe522b6129f16660d9b",
