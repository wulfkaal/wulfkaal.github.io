    },
    {
      "id": "kaal:claim:3409548-037:source-passage",
      "type": "SourcePassage",
      "text": "Most large fund advisers in the private equity and hedge fund industry have not yet considered implementing blockchain technology in combination with big data applications and artificial intelligence.",
      "text_sha256": "ef8acbe27686a71451ec0599c00897d7ffe4c4b704357c1572e125618b73c800",
