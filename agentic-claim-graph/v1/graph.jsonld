      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "evidenced",
      "relevance_score": 8
    },
    {
      "id": "kaal:claim:2389416-015:source-passage",
      "type": "SourcePassage",
      "text": "The largest positive spike, which corresponds to the largest number of funds that decreased their AUM below $150 million is in the period April-May 2012, possibly suggesting some lagged effect of the registration effective date for hedge fund advisers under the Dodd-Frank Act.",
      "text_sha256": "55daa27f0302b76f114e426dcd0f72fde79762eefc626980291c21e2eae3050d",
      "source_sha256": "0e1c4615b104821577498d9655de43b9c5c3e985bb0215f56c038b8232be65c3",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:2389416-029",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/2389416-029",
      "text": "The Dodd-Frank Act registration threshold creates incentives strong enough that some advisers opt out of registration and disclosure by strategically changing their AUM size to stay below $150 million.",
      "claim_type": "mechanism",
      "topics": [
        "regulatory-failure",
        "risk-and-incentives"
      ],
      "scope_conditions": [
        "advisers with AUM floating around the $150 million threshold"
      ],
      "attribution_class": "source_derived",
