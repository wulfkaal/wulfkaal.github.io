    },
    {
      "id": "kaal:claim:2097160-019",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/2097160-019",
      "text": "Because conversion damages both the debt portion and the surviving equity portion of an executive's package at the moment equity matters most for total pay, the combined effect is a strong incentive for executives to lower risk in order to avoid the triggering event.",
      "claim_type": "mechanism",
      "topics": [
        "risk-and-incentives",
        "ai-and-agents",
        "contingent-capital"
      ],
      "scope_conditions": [
