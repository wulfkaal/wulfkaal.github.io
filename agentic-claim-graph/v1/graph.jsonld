      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 47
    },
    {
      "id": "kaal:claim:6607458-015:source-passage",
      "type": "SourcePassage",
      "text": "Hayekian price operates as a summary statistic. The coordinating signal in Computative Economics is not a single scalar price but the composite of price, reputation, and verified generative capacity.",
