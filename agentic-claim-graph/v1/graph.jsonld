      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:3799320-032",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/3799320-032",
      "text": "Reputation based governance creates a positive sum game because members have incentives to build lasting non fungible value through a long term record of productive cooperation.",
      "claim_type": "mechanism",
      "topics": [
        "reputation",
        "governance-design"
      ],
      "scope_conditions": [
        "non fungible reputation as the reward"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 60
    },
    {
      "id": "kaal:claim:3799320-032:source-passage",
      "type": "SourcePassage",
      "text": "By contrast, the reputation-based DAO of DAOs governance design creates a positive-sum game because DAO of DAOs members have incentives to create lasting non-fungible value for the DAO of DAOs by developing a long- term non-fungible record of productive cooperation",
      "text_sha256": "9dc24b87d885a09364800bb27e5f888fe059fcc40a5bb51f57bb557aee1530e8",
      "source_sha256": "c3dff852f2d3f04718c829a24189309a7db4d92d84f6045d3d4f562d87c03e63",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:3799320-033",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/3799320-033",
      "text": "Member reputation is inflationary by design, so non staking of reputation tokens or non voting leads to value depreciation, which incentivizes action and makes liveness faults less likely.",
      "claim_type": "mechanism",
      "topics": [
        "reputation",
        "tokenomics",
        "risk-and-incentives",
        "consensus-and-security"
      ],
      "scope_conditions": [
        "reputation that depreciates with non-use"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 72
    },
    {
      "id": "kaal:claim:3799320-033:source-passage",
      "type": "SourcePassage",
      "text": "reputation is inflationary in the DAO of DAOs design. As such, non-use, i.e., non-staking of reputation tokens or non-voting, would lead to value depreciation, which incentivizes action and thus value enhancement. Liveness faults become less likely.",
      "text_sha256": "4c9eb5e1b134f32fb71caa42e16c32db7c0b3443dd4af5c959e2d8872ca1d38f",
      "source_sha256": "c3dff852f2d3f04718c829a24189309a7db4d92d84f6045d3d4f562d87c03e63",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
