    {
      "id": "kaal:claim:3002908-017",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/3002908-017",
      "text": "Complex smart contracts involving several parties can only work if they rest on a verifiable and unhackable system, which is what blockchain technology supplies.",
