    {
      "id": "kaal:claim:2486570-013:source-passage",
      "type": "SourcePassage",
      "text": "We found that 63.47 percent of the N/DPAs in the sample contained references to preemptive remedial measures instituted before the execution of the N/DPA.",
      "text_sha256": "bdbc1ac82caa894993f5d238c26c231e122713e6369dc82564496bbcb35e379d",
