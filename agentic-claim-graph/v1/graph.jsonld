    {
      "id": "kaal:claim:5887242-009:source-passage",
      "type": "SourcePassage",
      "text": "At the core of the UDLC DAO's internal governance lies a reputation-based staking system that eliminates the corruptive influence of fungible tokens and plutocratic one-token-one-vote mechanics.",
      "text_sha256": "9f75ec6a4198d4eaf0b4e6c1e5526e57375144c34f481cce0e9fd50a19627f62",
