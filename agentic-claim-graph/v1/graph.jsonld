      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 39
    },
    {
      "id": "kaal:claim:3125827-019:source-passage",
      "type": "SourcePassage",
      "text": "Any blockchain subject to such governance is ultimately less secure than legacy centralized systems which pointedly address centralized security risks.",
      "text_sha256": "2d8b66adda279d71fa772666b9425c89e7d37a7d14be45bbfbc3a9f9443b9687",
      "source_sha256": "598d9bd95e4af7a0a35328677c6bfc069f69f2e32c30c720b3a0be98a23a40cb",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:3125827-024",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/3125827-024",
      "text": "A healthy expertise will have near unanimous consensus on every evidence of work validation pool, and that very unanimity creates an impediment to development, because honest members risk their stakes by voting for untested changes.",
      "claim_type": "failure",
