      "locator_status": "exact_quote_without_page_locator"
    },
    {
      "id": "kaal:claim:2998033-021",
      "type": "Claim",
      "canonical_url": "https://wulfkaal.github.io/claims/2998033-021",
      "text": "Repeated use of the same dataset by data scientists creates an overfitting risk: the training model fits the test set so closely that its performance on a different dataset degrades.",
      "claim_type": "failure",
      "topics": [
        "ai-and-agents",
        "risk-and-incentives"
      ],
      "scope_conditions": [
        "applies to adaptive data analysis where the same data set is used repetitively"
      ],
      "attribution_class": "source_derived",
      "attribution_status": "directly_attributable_to_wulf_a_kaal",
      "verification_status": "current",
      "source_quote_status": "present_in_canonical_claim_record",
      "source_quote_individual_match_status": "not_recomputed_by_pilot",
      "confidence": "argued",
      "relevance_score": 26
    },
    {
      "id": "kaal:claim:2998033-021:source-passage",
      "type": "SourcePassage",
      "text": "When data scientists use the same data set repetitively a risk exists that the training model will overfit the test set of data which can limit the performance of the applied model on a different dataset.",
      "text_sha256": "56f35a9358b8667250b8c7d730ca6b177af73f2bfb870e20cd08bb8a49df8f16",
      "source_sha256": "aafb1be3c25cd33da477d759df9ca2f856f0a8fe133d6396da2e75d0af573dbd",
      "locator_status": "exact_quote_without_page_locator"
    },
    {
