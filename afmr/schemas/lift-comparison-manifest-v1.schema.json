{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wulfkaal.github.io/afmr/schemas/lift-comparison-manifest-v1.schema.json",
  "title": "AFMR Lift Comparison Manifest 1.0",
  "description": "Pre-registered, configuration-scoped comparison plan. Outcomes are not part of this manifest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "manifest_id",
    "created_at",
    "configuration_cell",
    "preregistration",
    "cohort",
    "metrics",
    "evaluation_plan",
    "provenance",
    "signatures",
    "limitations"
  ],
  "properties": {
    "schema_id": {
      "const": "https://wulfkaal.github.io/afmr/schemas/lift-comparison-manifest-v1.schema.json"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "manifest_id": {
      "type": "string",
      "pattern": "^lift-manifest:[A-Za-z0-9._:-]{8,160}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "configuration_cell": {
      "$ref": "#/$defs/configurationCell"
    },
    "preregistration": {
      "$ref": "#/$defs/preregistration"
    },
    "cohort": {
      "$ref": "#/$defs/cohortPlan"
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/metricDefinition"
      }
    },
    "evaluation_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assignment_method",
        "comparison_method",
        "missing_data_policy",
        "stopping_rule",
        "challenge_window"
      ],
      "properties": {
        "assignment_method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "comparison_method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "missing_data_policy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "stopping_rule": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "challenge_window": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      }
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/signature"
      }
    },
    "limitations": {
      "$ref": "#/$defs/limitations"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "configurationCell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cell_id",
        "cell_digest",
        "model",
        "harness",
        "protocol",
        "task",
        "evaluator",
        "afmr_version",
        "observation_window"
      ],
      "properties": {
        "cell_id": {
          "$ref": "#/$defs/identifier"
        },
        "cell_digest": {
          "$ref": "#/$defs/sha256"
        },
        "model": {
          "$ref": "#/$defs/identifier"
        },
        "harness": {
          "$ref": "#/$defs/identifier"
        },
        "protocol": {
          "$ref": "#/$defs/identifier"
        },
        "task": {
          "$ref": "#/$defs/identifier"
        },
        "evaluator": {
          "$ref": "#/$defs/identifier"
        },
        "afmr_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"
        },
        "observation_window": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "starts_at",
            "ends_at"
          ],
          "properties": {
            "starts_at": {
              "type": "string",
              "format": "date-time"
            },
            "ends_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      }
    },
    "preregistration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commitment_sha256",
        "registered_at",
        "registry_url",
        "metric_ids",
        "cohort_definition_sha256"
      ],
      "properties": {
        "commitment_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "registered_at": {
          "type": "string",
          "format": "date-time"
        },
        "registry_url": {
          "type": "string",
          "format": "uri"
        },
        "metric_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "cohort_definition_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "cohortPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "baseline_label",
        "comparison_label",
        "inclusion_criteria",
        "exclusion_criteria",
        "minimum_baseline_count",
        "minimum_comparison_count"
      ],
      "properties": {
        "unit": {
          "$ref": "#/$defs/identifier"
        },
        "baseline_label": {
          "$ref": "#/$defs/identifier"
        },
        "comparison_label": {
          "$ref": "#/$defs/identifier"
        },
        "inclusion_criteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "exclusion_criteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "minimum_baseline_count": {
          "type": "integer",
          "minimum": 1
        },
        "minimum_comparison_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "metricDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_id",
        "name",
        "direction",
        "lower_bound",
        "upper_bound",
        "measurement_method"
      ],
      "properties": {
        "metric_id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "direction": {
          "enum": [
            "higher_is_better",
            "lower_is_better"
          ]
        },
        "lower_bound": {
          "type": "number"
        },
        "upper_bound": {
          "type": "number"
        },
        "measurement_method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "unit": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "creator",
        "source_digest",
        "redaction_policy",
        "canonical_url"
      ],
      "properties": {
        "creator": {
          "$ref": "#/$defs/identifier"
        },
        "source_digest": {
          "$ref": "#/$defs/sha256"
        },
        "redaction_policy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "canonical_url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signer_id",
        "scheme",
        "public_key_hex",
        "signature_hex",
        "signed_digest"
      ],
      "properties": {
        "signer_id": {
          "$ref": "#/$defs/identifier"
        },
        "scheme": {
          "const": "ed25519"
        },
        "public_key_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "signature_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{128}$"
        },
        "signed_digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "limitations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configuration_scoped",
        "individual_reputation",
        "universal_lift_claim",
        "safety_guarantee"
      ],
      "properties": {
        "configuration_scoped": {
          "const": true
        },
        "individual_reputation": {
          "const": false
        },
        "universal_lift_claim": {
          "const": false
        },
        "safety_guarantee": {
          "const": false
        }
      }
    }
  }
}
