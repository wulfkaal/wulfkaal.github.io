{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wulfkaal.github.io/afmr/schemas/lift-comparison-public-card-v1.schema.json",
  "title": "AFMR Lift Comparison Public Card v1",
  "description": "Redacted, signed projection of a configuration-scoped cohort comparison.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "card_id",
    "manifest_id",
    "artifact_digest",
    "evidence_maturity",
    "configuration_cell",
    "preregistration",
    "cohort",
    "metrics",
    "within_cell_lift",
    "review",
    "challenge",
    "lifecycle",
    "supersession",
    "provenance",
    "signatures",
    "verification_links",
    "limitations"
  ],
  "properties": {
    "schema_id": {
      "const": "https://wulfkaal.github.io/afmr/schemas/lift-comparison-public-card-v1.schema.json"
    },
    "schema_version": {"const": "1.0.0"},
    "card_id": {"$ref": "#/$defs/sha256"},
    "manifest_id": {"$ref": "#/$defs/sha256"},
    "artifact_digest": {"$ref": "#/$defs/digest"},
    "evidence_maturity": {
      "enum": ["configuration_only", "preregistered", "measured", "review_ready", "reviewed"]
    },
    "configuration_cell": {"$ref": "#/$defs/configurationCell"},
    "preregistration": {"$ref": "#/$defs/preregistration"},
    "cohort": {"$ref": "#/$defs/cohort"},
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/metric"}
    },
    "within_cell_lift": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {"$ref": "#/$defs/lift"}
    },
    "review": {"$ref": "#/$defs/review"},
    "challenge": {"$ref": "#/$defs/challenge"},
    "lifecycle": {"$ref": "#/$defs/lifecycle"},
    "supersession": {"$ref": "#/$defs/supersession"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "signatures": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/signature"}
    },
    "verification_links": {
      "type": "array",
      "items": {"$ref": "#/$defs/link"}
    },
    "limitations": {"$ref": "#/$defs/limitations"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "value": {"$ref": "#/$defs/sha256"}
      }
    },
    "configurationCell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cell_id",
        "cell_digest",
        "model",
        "harness",
        "governance_protocol_digest",
        "task",
        "evaluator",
        "afmr_version"
      ],
      "properties": {
        "cell_id": {"$ref": "#/$defs/sha256"},
        "cell_digest": {"$ref": "#/$defs/digest"},
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "name", "version"],
          "properties": {
            "provider": {"type": "string", "minLength": 1},
            "name": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1}
          }
        },
        "harness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "configuration_digest"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "configuration_digest": {"$ref": "#/$defs/digest"}
          }
        },
        "governance_protocol_digest": {"$ref": "#/$defs/digest"},
        "task": {"$ref": "#/$defs/versionedId"},
        "evaluator": {"$ref": "#/$defs/versionedId"},
        "afmr_version": {"type": "string", "pattern": "^[0-9]+[.][0-9]+$"}
      }
    },
    "versionedId": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "preregistration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commitment_id",
        "commitment_digest",
        "committed_at",
        "metric_ids",
        "cohort_definition_digest"
      ],
      "properties": {
        "commitment_id": {"$ref": "#/$defs/sha256"},
        "commitment_digest": {"$ref": "#/$defs/digest"},
        "committed_at": {"type": "string", "format": "date-time"},
        "metric_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "cohort_definition_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "cohort": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cohort_id",
        "inclusion_digest",
        "exclusion_digest",
        "observation_window",
        "baseline_n",
        "comparison_n"
      ],
      "properties": {
        "cohort_id": {"type": "string", "minLength": 1},
        "inclusion_digest": {"$ref": "#/$defs/digest"},
        "exclusion_digest": {"$ref": "#/$defs/digest"},
        "observation_window": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": {"type": "string", "format": "date-time"},
            "end": {"type": "string", "format": "date-time"}
          }
        },
        "baseline_n": {"type": "integer", "minimum": 1},
        "comparison_n": {"type": "integer", "minimum": 1}
      }
    },
    "metricValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n", "value"],
      "properties": {
        "n": {"type": "integer", "minimum": 1},
        "value": {"type": "number"}
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_id",
        "metric_version",
        "unit",
        "bounds",
        "direction",
        "baseline",
        "comparison"
      ],
      "properties": {
        "metric_id": {"type": "string", "minLength": 1},
        "metric_version": {"type": "string", "minLength": 1},
        "unit": {"type": "string", "minLength": 1},
        "bounds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": {
            "min": {"type": "number"},
            "max": {"type": "number"}
          }
        },
        "direction": {"enum": ["higher_is_better", "lower_is_better"]},
        "baseline": {"$ref": "#/$defs/metricValue"},
        "comparison": {"$ref": "#/$defs/metricValue"}
      }
    },
    "lift": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric_id", "method", "estimate", "interval"],
      "properties": {
        "metric_id": {"type": "string", "minLength": 1},
        "method": {"enum": ["absolute_difference", "relative_change"]},
        "estimate": {"type": "number"},
        "interval": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["lower", "upper"],
              "properties": {
                "lower": {"type": "number"},
                "upper": {"type": "number"}
              }
            },
            {"type": "null"}
          ]
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewed_at", "reviewer_ids"],
      "properties": {
        "status": {
          "enum": ["unreviewed", "in_review", "accepted", "changes_requested", "challenged", "resolved"]
        },
        "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
        "reviewer_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "challenge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "challenge_ids"],
      "properties": {
        "status": {"enum": ["none", "open", "upheld", "rejected", "withdrawn", "resolved"]},
        "challenge_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "effective_at"],
      "properties": {
        "status": {"enum": ["draft", "active", "suspended", "superseded", "revoked", "expired"]},
        "effective_at": {"type": "string", "format": "date-time"}
      }
    },
    "supersession": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "previous_card_id", "next_card_id"],
      "properties": {
        "status": {"enum": ["none", "supersedes", "superseded"]},
        "previous_card_id": {
          "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        },
        "next_card_id": {
          "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generated_at",
        "generator_id",
        "generator_version",
        "source_manifest_digest",
        "redaction_policy_id",
        "source_artifact_digests"
      ],
      "properties": {
        "generated_at": {"type": "string", "format": "date-time"},
        "generator_id": {"type": "string", "minLength": 1},
        "generator_version": {"type": "string", "minLength": 1},
        "source_manifest_digest": {"$ref": "#/$defs/digest"},
        "redaction_policy_id": {"type": "string", "minLength": 1},
        "source_artifact_digests": {
          "type": "array",
          "items": {"$ref": "#/$defs/digest"}
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signer_id", "key_id", "algorithm", "signed_at", "signature"],
      "properties": {
        "signer_id": {"type": "string", "minLength": 1},
        "key_id": {"type": "string", "minLength": 1},
        "algorithm": {"type": "string", "minLength": 1},
        "signed_at": {"type": "string", "format": "date-time"},
        "signature": {"type": "string", "minLength": 1}
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rel", "href"],
      "properties": {
        "rel": {"enum": ["manifest", "schema", "status", "evidence", "challenge"]},
        "href": {"type": "string", "format": "uri"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "limitations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configuration_scoped",
        "individual_reputation",
        "universal_lift_claim",
        "safety_guarantee",
        "notice"
      ],
      "properties": {
        "configuration_scoped": {"const": true},
        "individual_reputation": {"const": false},
        "universal_lift_claim": {"const": false},
        "safety_guarantee": {"const": false},
        "notice": {"type": "string", "minLength": 1}
      }
    }
  }
}
